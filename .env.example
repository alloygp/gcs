# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Resend ──────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Form send-failure alerts (Slack) ────────────────────────────
# Same Slack Incoming Webhook URL as the resend-slack-alerts project, so
# submission-side failures land in the same channel. Leave blank to disable
# (forms keep working; the helper just no-ops and logs a warning).
FORM_ALERT_SLACK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx

# ── Mailchimp (delete these 3 lines if not using Mailchimp) ─────
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxxxx

# ── Internal notifications ──────────────────────────────────────
INTERNAL_NOTIFY_EMAIL=owner@clientsite.com

# ── Google Analytics (leave blank to skip GA entirely) ──────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Shopmonkey (powers /appointments → creates customer + vehicle + order) ──
# API key: Shopmonkey → Settings → Integration → API Keys (admin only).
# The key alone scopes company + location (single-location shop). Leave blank
# to disable — the form still works and the shop still gets the email.
SHOPMONKEY_API_KEY=
# Optional overrides:
SHOPMONKEY_API_BASE=https://api.shopmonkey.cloud/v3
# Workflow board column new leads land in. Defaults in code to this shop's
# "Customer Pool & Appointments" column; set to override (GET /v3/workflow_status).
SHOPMONKEY_WORKFLOW_STATUS_ID=

# ── Shop-editable booking date (Vercel Edge Config) ─────────────
# Lets the shop change the earliest bookable date at /admin/booking with no deploy.
# The appointments calendar reads it via /api/booking-config; falls back to a baked-in
# date (src/lib/booking-config.ts) if unset. Setup:
#   1. Create an Edge Config store:  vercel edge-config add gcs-booking --items '{"bookingFloor":"2026-06-24"}'
#   2. Mint a read token:            vercel edge-config tokens <ecfg_id> --add gcs-read
#   3. EDGE_CONFIG = https://edge-config.vercel.com/<ecfg_id>?token=<readToken>
#   4. VERCEL_API_TOKEN = a Vercel API token with write access (dashboard → Account → Tokens)
#   5. VERCEL_TEAM_ID = the team that owns the store
#   6. ADMIN_BOOKING_PASSWORD = the password the shop types on /admin/booking
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxxxxxxx
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=team_xxxxxxxx
ADMIN_BOOKING_PASSWORD=

# ── Live Google reviews on /reviews ─────────────────────────────
# The "Read all on Google" / "Leave a review" buttons already point to the real
# listing via the baked-in Place ID. To also show live-fetched review cards, add a
# Google Maps JavaScript API key with the "Places API (New)" enabled, restricted by
# HTTP referrer to your domain(s). Both are PUBLIC_ (safe to expose client-side).
#   PUBLIC_GOOGLE_MAPS_API_KEY = your referrer-restricted Maps JS key
#   PUBLIC_GOOGLE_PLACE_ID     = optional override; defaults to the shop's Place ID in code
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_GOOGLE_PLACE_ID=ChIJG9XmvbhdXIYR2fUq34LMeWE
