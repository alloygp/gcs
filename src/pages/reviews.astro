---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `Reviews — What San Antonio Drivers Say | My German Car SA`;
const DESC = `Why San Antonio Audi, BMW, Mercedes & Porsche owners choose My German Car SA over the dealership. Carfax Top-Rated service.`;
const CANON = `https://mygermancarsa.com/reviews`;
const SCREEN = `Reviews`;
const BLOG = false;
const DEFAULT_MAKE = undefined;
const STYLE = `/* reviews-page specifics */
.hero.rev .container{grid-template-columns:1.05fr .95fr;}
.ratingbox{background:#fff;border:1px solid var(--fog);border-radius:16px;box-shadow:0 24px 56px rgba(12,14,18,.12);padding:clamp(28px,3.4vw,40px);}
.ratingbox .top{display:flex;align-items:center;gap:22px;padding-bottom:22px;border-bottom:1px solid var(--fog);}
.ratingbox .score{font-family:var(--font-display);font-size:72px;font-weight:900;line-height:.9;color:var(--navy);letter-spacing:-.02em;}
.ratingbox .meta .gs{display:flex;gap:2px;color:var(--star);margin-bottom:6px;}
.ratingbox .meta .gs svg{width:20px;height:20px;fill:var(--star);stroke:none;}
.ratingbox .meta b{font-size:15px;color:var(--navy);font-weight:700;display:flex;align-items:center;gap:8px;}
.ratingbox .meta small{display:block;font-size:13px;color:var(--steel-500);margin-top:3px;}
.ratingbox .src{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px;}
.ratingbox .src .s{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--fog);border-radius:10px;}
.ratingbox .src .s .ic{width:34px;height:34px;border-radius:8px;display:grid;place-items:center;flex:none;background:var(--mist);color:var(--acc);}
.ratingbox .src .s .ic svg{width:18px;height:18px;}
.ratingbox .src .s b{display:block;font-size:15px;color:var(--navy);font-weight:800;line-height:1.1;}
.ratingbox .src .s span{font-size:12px;color:var(--steel-500);}
@media(max-width:920px){.hero.rev .container{grid-template-columns:1fr;}}

.rev-grid.wide{grid-template-columns:repeat(3,1fr);}
.rcard .rsrc{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--steel-400);margin-left:auto;}
.rcard .rsrc svg{width:13px;height:13px;}
.rcard .rtop{display:flex;align-items:center;gap:10px;}

/* carfax band */
.carfax{background:var(--navy);color:#fff;}
.carfax .container{display:grid;grid-template-columns:auto 1fr auto;gap:40px;align-items:center;}
.carfax .badge{width:96px;height:96px;border-radius:18px;background:rgba(216,18,34,.14);border:1px solid rgba(216,18,34,.4);display:grid;place-items:center;color:var(--acc-mid);flex:none;}
.carfax .badge svg{width:48px;height:48px;}
.carfax h2{font-family:var(--font-display);font-size:clamp(26px,3vw,40px);font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:#fff;margin:0 0 10px;line-height:1.03;}
.carfax p{font-size:16px;line-height:1.62;color:rgba(255,255,255,.74);margin:0;max-width:64ch;}
.carfax .eyebrow{color:var(--acc-mid);margin-bottom:14px;}
.carfax .eyebrow::before{background:var(--acc-mid);}
@media(max-width:760px){.carfax .container{grid-template-columns:1fr;text-align:center;}.carfax .badge{margin:0 auto;}.carfax p{margin:0 auto;}.carfax .btn{justify-self:center;}}

/* google embed placeholder */
.gembed{border:1px solid var(--fog);border-radius:14px;overflow:hidden;background:#fff;max-width:980px;margin:0 auto;box-shadow:var(--shadow-sm,0 2px 8px rgba(0,0,0,.05));}
.gembed .gbar{display:flex;align-items:center;gap:12px;padding:18px 24px;border-bottom:1px solid var(--fog);}
.gembed .gbar b{font-size:15px;font-weight:800;color:var(--navy);}
.gembed .gbar .lk{margin-left:auto;font-size:12px;color:var(--steel-400);display:inline-flex;align-items:center;gap:6px;}
.gembed .gbar .lk svg{width:13px;height:13px;}
.gembed .gbody{padding:48px 32px;text-align:center;color:var(--steel-400);font-family:var(--mono);font-size:13px;letter-spacing:.04em;}
.gembed .gbody i{display:block;margin:0 auto 12px;}`;
const CONTENT = `<!-- BREADCRUMB -->
<div class="crumbbar"><div class="container"><div class="crumb"><a href="/">Home</a><i data-lucide="chevron-right"></i><span class="cur">Reviews</span></div></div></div>

<!-- HERO -->
<section class="hero rev">
  <div class="container">
    <div class="hero-copy">
      <span class="eyebrow">Reviews &amp; Testimonials</span>
      <h1 class="display" style="margin:14px 0 18px">What San Antonio <em>drivers say.</em></h1>
      <p class="lead">Audi, BMW, Mercedes and Porsche owners across San Antonio trust us with the cars they love — a 4.9-star average across 325 Google reviews, and Carfax Top-Rated. Here's why they choose us over the dealership.</p>
      <div class="hero-cta" style="margin-top:28px">
        <a class="btn btn-primary" href="https://www.google.com/maps?q=German+Car+Specialists+San+Antonio" target="_blank" rel="noopener"><i data-lucide="star"></i>Read on Google</a>
        <a class="btn btn-ghost" href="/appointments"><i data-lucide="calendar-check"></i>Book Your Service</a>
      </div>
    </div>
    <div class="hero-vis">
      <div class="ratingbox">
        <div class="top">
          <div class="score">4.9</div>
          <div class="meta">
            <div class="gs" id="rb-s"></div>
            <b><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.6.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg>Google Rating</b>
            <small>325 verified reviews</small>
          </div>
        </div>
        <div class="src">
          <div class="s"><span class="ic"><i data-lucide="shield-check"></i></span><div><b>Carfax</b><span>Top-Rated Shop</span></div></div>
          <div class="s"><span class="ic"><i data-lucide="badge-check"></i></span><div><b>98%</b><span>5-star reviews</span></div></div>
          <div class="s"><span class="ic"><i data-lucide="calendar-days"></i></span><div><b>Est. 2010</b><span>Independent</span></div></div>
          <div class="s"><span class="ic"><i data-lucide="repeat"></i></span><div><b>Repeat</b><span>Customer-driven</span></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee"><div class="track">
  <div class="seg"><b>4.9 ★ Google</b><b>325 Reviews</b><b>Carfax Top-Rated</b><b>Audi · BMW · Mercedes · Porsche</b></div>
  <div class="seg"><b>4.9 ★ Google</b><b>325 Reviews</b><b>Carfax Top-Rated</b><b>Audi · BMW · Mercedes · Porsche</b></div>
</div></div>

<!-- STAT BAND -->
<section class="stats"><div class="container">
  <div class="statc"><b>4.9<span class="r">★</span></b><span>Average Rating</span></div>
  <div class="statc"><b>325</b><span>Google Reviews</span></div>
  <div class="statc"><b>98%</b><span>Five Stars</span></div>
  <div class="statc"><b>2010</b><span>Independent Since</span></div>
</div></section>

<!-- REVIEWS -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">In their own words</span>
      <h2 class="h2">Owners who left the dealer for good.</h2>
      <p class="lead">Real reviews from San Antonio Audi, BMW, Mercedes and Porsche drivers — on the work, the honesty, and the price.</p>
    </div>
    <div class="rev-grid wide">
      <div class="rcard feat reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"Quoted me less than half what the BMW dealer wanted and finished the same day. They texted photos of everything before touching the car. I'm never going back to the dealer."</p>
        <div class="who"><span class="av">MR</span><div><b>Marcus R.</b><span>BMW 540i &amp; X5</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"My Audi had an electrical issue three shops couldn't find — GCS diagnosed it in an afternoon. Honest, fast, and they truly know these cars."</p>
        <div class="who"><span class="av">JL</span><div><b>Jenna L.</b><span>Audi Q5</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"Loaner ready, work done right, zero surprise charges. They treat my Porsche better than the dealership ever did. This is how a shop should run."</p>
        <div class="who"><span class="av">DT</span><div><b>David T.</b><span>Porsche Cayenne</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"Service B on my E-Class for a few hundred less than Mercedes wanted, and they showed me exactly what was done. Found my shop for life."</p>
        <div class="who"><span class="av">SP</span><div><b>Sandra P.</b><span>Mercedes E350</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"They handle the DSG service on my S4 better than the dealer did — and explain everything with photos. Genuinely know these cars inside out."</p>
        <div class="who"><span class="av">RB</span><div><b>Rafael B.</b><span>Audi S4</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"Trusted them with my air-cooled 911 and they treated it like their own — OEM parts, correct torque specs, clear communication. Rare to find this level."</p>
        <div class="who"><span class="av">MS</span><div><b>Mark S.</b><span>Porsche 911</span></div></div>
      </div>
      <div class="rcard feat reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"After years of dealer markups I was skeptical an independent could match it. They more than did — same OEM parts, factory-level diagnostics, and they kept my warranty paperwork in order. Saved hundreds."</p>
        <div class="who"><span class="av">CV</span><div><b>Carlos V.</b><span>BMW X3</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"Pre-purchase inspection on a used Q7 caught two issues the seller hadn't mentioned. Saved me from a bad buy. Worth every penny."</p>
        <div class="who"><span class="av">AH</span><div><b>Amanda H.</b><span>Audi Q7</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rtop"><div class="rs" data-stars></div><span class="rsrc"><i data-lucide="star"></i>Google</span></div>
        <p>"Straightforward, fair, and they actually pick up the phone. My GLE has never run better and I always know what I'm paying before they start."</p>
        <div class="who"><span class="av">TN</span><div><b>Trevor N.</b><span>Mercedes GLE</span></div></div>
      </div>
    </div>
  </div>
</section>

<!-- CARFAX BAND -->
<section class="sec carfax">
  <div class="container">
    <div class="badge"><i data-lucide="shield-check"></i></div>
    <div>
      <span class="eyebrow">Carfax Top-Rated</span>
      <h2>Verified by the people who track your car's history.</h2>
      <p>Carfax names a Top-Rated Service Shop only when it earns consistently high, verified reviews from real customers. It's independent proof that the work, the honesty and the value behind our 4.9-star rating hold up — month after month.</p>
    </div>
    <a class="btn btn-light" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
  </div>
</section>

<!-- GOOGLE EMBED -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Straight from Google</span>
      <h2 class="h2">See all 325 reviews.</h2>
      <p class="lead">We don't cherry-pick. Read every review, unfiltered, on our Google Business profile.</p>
    </div>
    <div class="gembed reveal">
      <div class="gbar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.6.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg>
        <b>German Car Specialists · 4.9 ★ (325)</b>
        <a class="lk" href="https://www.google.com/maps?q=German+Car+Specialists+San+Antonio" target="_blank" rel="noopener">Open in Google <i data-lucide="external-link"></i></a>
      </div>
      <div class="gbody"><i data-lucide="messages-square"></i>↑ Embed your live Google Reviews widget here</div>
    </div>
  </div>
</section>

<!-- BOOKING -->
<section class="sec book" id="book">
  <div class="container">
    <div class="book-shell" style="grid-template-columns:1fr;text-align:center;max-width:720px;margin:0 auto">
      <div class="book-copy reveal">
        <span class="eyebrow" style="justify-content:center">Book · Estimate · Ask</span>
        <h2 class="h2" data-make-tpl="Let's get your {make} taken care of." style="text-align:center">Ready to skip the dealer?</h2>
        <p class="lead" style="margin:16px auto 30px;max-width:54ch">Book a service, ask for an estimate, or just send a question — one quick form, answered the same business day by a real technician at the shop.</p>
        <div class="hero-cta" style="justify-content:center">
          <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
          <a class="btn btn-light" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
        </div>
      </div>
    </div>
  </div>
</section>`;
const JSONLD = `<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"AutoRepair",
  "@id":"https://mygermancarsa.com/#shop",
  "name":"German Car Specialists",
  "image":"https://mygermancarsa.com/assets/logo-color.png",
  "telephone":"+1-210-399-1172",
  "priceRange":"$$",
  "address":{"@type":"PostalAddress","streetAddress":"15555 Tradesman Dr, Ste 500","addressLocality":"San Antonio","addressRegion":"TX","postalCode":"78249","addressCountry":"US"},
  "areaServed":"San Antonio, TX",
  "openingHours":["Mo-Th 07:30-17:30","Fr 07:30-17:00"],
  "aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"325","bestRating":"5"},
  "review":[
    {"@type":"Review","author":{"@type":"Person","name":"Marcus R."},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":"Quoted me less than half what the BMW dealer wanted and finished the same day. They texted photos of everything before touching the car. I'm never going back to the dealer."},
    {"@type":"Review","author":{"@type":"Person","name":"Jenna L."},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":"My Audi had an electrical issue three shops couldn't find — GCS diagnosed it in an afternoon. Honest, fast, and they truly know these cars."},
    {"@type":"Review","author":{"@type":"Person","name":"David T."},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":"Loaner ready, work done right, zero surprise charges. They treat my Porsche better than the dealership ever did. This is how a shop should run."},
    {"@type":"Review","author":{"@type":"Person","name":"Sandra P."},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":"Service B on my E-Class for a few hundred less than Mercedes wanted, and they showed me exactly what was done. Found my shop for life."},
    {"@type":"Review","author":{"@type":"Person","name":"Carlos V."},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":"After years of dealer markups I was skeptical an independent could match it. They more than did — same OEM parts, factory-level diagnostics, and kept my warranty paperwork in order."}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Organization",
  "name":"German Car Specialists",
  "url":"https://mygermancarsa.com/",
  "logo":"https://mygermancarsa.com/assets/logo-color.png",
  "telephone":"+1-210-399-1172",
  "foundingDate":"2010",
  "sameAs":["https://www.instagram.com/mygermancarsa"]
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":"https://mygermancarsa.com/"},
    {"@type":"ListItem","position":2,"name":"Reviews","item":"https://mygermancarsa.com/reviews"}
  ]
}
</script>`;
---
<BaseLayout title={TITLE} description={DESC} canonical={CANON} screenLabel={SCREEN} blog={BLOG} defaultMake={DEFAULT_MAKE}>
  <Fragment slot="head" set:html={STYLE ? ('<style>'+STYLE+'</style>') : ''} />
  <Fragment set:html={CONTENT} />
  <Fragment slot="end" set:html={JSONLD} />
</BaseLayout>
