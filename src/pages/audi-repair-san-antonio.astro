---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `Audi Repair San Antonio | Independent Audi Service`;
const DESC = `Expert Audi repair & service in San Antonio without dealer prices. Factory-level diagnostics, master techs, Carfax Top-Rated. Book your Audi today.`;
const CANON = `https://mygermancarsa.com/audi-repair-san-antonio`;
const SCREEN = `Audi Repair San Antonio`;
const BLOG = false;
const DEFAULT_MAKE = 'Audi';
const STYLE = ``;
const CONTENT = `<!-- BREADCRUMB -->
<div class="crumbbar"><div class="container"><div class="crumb"><a href="/">Home</a><i data-lucide="chevron-right"></i><a href="#">Makes</a><i data-lucide="chevron-right"></i><span class="cur">Audi</span></div></div></div>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-copy">
      <div class="hero-make"><img src="/assets/marques/audi.svg" alt="Audi" width="48" height="48" ><span>Specialist Service</span></div>
      <h1 class="display">Audi Repair in <em>San Antonio.</em></h1>
      <p class="lead">Dealer-level Audi service without the dealer markup. Factory-trained technicians, Audi diagnostic equipment, and OEM parts — from routine maintenance to carbon cleaning, timing chains and DSG service.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book Audi Service</a>
        <a class="btn btn-ghost" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
      </div>
      <div class="hero-mini">
        <div class="hm"><i data-lucide="shield-check"></i><span>24-month / 24k warranty</span></div>
        <div class="hm"><i data-lucide="cpu"></i><span>Audi diagnostics</span></div>
        <div class="hm"><i data-lucide="package-check"></i><span>OEM parts only</span></div>
      </div>
    </div>
    <div class="hero-vis">
      <div class="frame"><img src="/assets/audi-v6-coolant-service.webp" alt="Technician servicing the cooling system on an Audi V6" width="800" height="470" loading="eager"></div>
      <div class="float">
        <div class="big">4.9</div>
        <div>
          <div class="grow"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.6.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg><b>Google Rating</b></div>
          <div class="gs" id="hero-s"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></div><small>Verified Google reviews</small>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee"><div class="track">
  <div class="seg"><b>A4 / A6</b><b>Q5 / Q7</b><b>S &amp; RS</b><b>R8 V10</b><b>Factory-Trained</b><b>OEM Parts Only</b></div>
  <div class="seg"><b>A4 / A6</b><b>Q5 / Q7</b><b>S &amp; RS</b><b>R8 V10</b><b>Factory-Trained</b><b>OEM Parts Only</b></div>
</div></div>

<!-- STAT BAND -->
<section class="stats"><div class="container">
  <div class="statc"><b><svg viewBox="0 0 24 24" width="50" height="50" fill="none" stroke="#ffffff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="m9 12 2 2 4-4"/><path d="M12 3l2.3 1.7 2.8-.2 1 2.7 2.3 1.6-.7 2.7.7 2.7-2.3 1.6-1 2.7-2.8-.2L12 21l-2.3-1.7-2.8.2-1-2.7L3.6 15l.7-2.7L3.6 9.6l2.3-1.6 1-2.7 2.8.2z"/></svg></b><span>Carfax Top-Rated</span></div>
  <div class="statc"><b>4.9★</b><span>Google Rating</span></div>
  <div class="statc"><b>2010</b><span>Independent Since</span></div>
  <div class="statc"><b>OEM</b><span>Audi Parts Only</span></div>
</div></section>

<!-- INTRO -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">San Antonio's Audi Specialists</span>
      <h2 class="h2">The honest alternative to the Audi dealer.</h2>
    </div>
    <div class="prose reveal">
      <p>Searching for <strong>Audi repair near me</strong> in San&nbsp;Antonio? The dealership isn't your only option that does it right. At <strong>German Car Specialists</strong>, Audi is one of the four marques we've focused on since 2010 — so your car is handled by master technicians who know Audi’s platforms and quattro driveline inside out, using factory-level diagnostic equipment and <strong>genuine OEM and OE-supplier parts</strong>. We're <strong>Carfax Top-Rated</strong> and a trusted Audi mechanic in San&nbsp;Antonio for owners who want dealer-quality work without dealer prices.</p>
      <p>The difference is everything around the work: <strong>honest, photo-documented inspections</strong>, estimates you approve before we lift a wrench, faster turnaround, and pricing that typically runs well below dealer rates. From routine Audi service in San&nbsp;Antonio — an oil service on an A4 — to carbon cleaning, a timing chain tensioner or DSG mechatronics, we keep your Audi running like it should, and back every repair with a <strong>24-month / 24,000-mile warranty</strong>.</p>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Audi Services</span>
      <h2 class="h2">Complete Audi repair &amp; maintenance.</h2>
      <p class="lead">Everything your Audi needs, under one roof — no dealer trip required.</p>
    </div>
    <div class="svc-grid">
      <div class="svc reveal"><div class="ico"><i data-lucide="activity"></i></div><h3>Diagnostics &amp; Check Engine Light</h3><p>Audi-specific scan tools read every module to pinpoint the real fault — fast, accurate, no guesswork.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="calendar-clock"></i></div><h3>Oil Service &amp; Maintenance</h3><p>Factory-interval service with OEM filters and the correct VW 502/504-spec synthetic oil.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="wind"></i></div><h3>Carbon Cleaning &amp; Walnut Blasting</h3><p>Direct-injection intake-valve carbon buildup removed to restore power and smooth idle on TFSI engines.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="git-commit-horizontal"></i></div><h3>DSG / S tronic Service</h3><p>DSG fluid &amp; filter service and mechatronics repair on dual-clutch transmissions, done to spec.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="cog"></i></div><h3>Engine &amp; Timing Chain</h3><p>Timing chain tensioners, turbochargers, water pumps and oil consumption fixes.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="zap"></i></div><h3>Electrical &amp; Coding</h3><p>Modules, sensors, MMI faults and coding/retrofits most shops send back to the dealer.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="disc-3"></i></div><h3>Brakes &amp; Suspension</h3><p>OEM-spec pads and rotors, control arms, air suspension and quattro-correct alignment.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="thermometer-snowflake"></i></div><h3>Cooling System</h3><p>Water pumps, thermostats and the plastic coolant flanges that fail in Texas heat.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="clipboard-check"></i></div><h3>Pre-Purchase Inspection</h3><p>Buying a used Audi? A documented, bumper-to-bumper report before you sign anything.</p></div>
    </div>
  </div>
</section>

<!-- COMMON PROBLEMS -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Common Audi Issues We Fix</span>
      <h2 class="h2">We know where these cars need help.</h2>
      <p class="lead">Years of Audi-focused experience means we diagnose the known failure points quickly — and fix them right.</p>
    </div>
    <div class="prob-grid">
      <div class="prob reveal"><div class="pi"><i data-lucide="wind"></i></div><div><span class="eng">2.0T · 3.0T TFSI</span><h3>Carbon Buildup</h3><p>Direct injection lets carbon cake onto intake valves — we walnut-blast it clean to restore power and economy.</p></div></div>
      <div class="prob reveal"><div class="pi"><i data-lucide="link-2"></i></div><div><span class="eng">2.0T TFSI</span><h3>Timing Chain Tensioner</h3><p>A failing tensioner can let the chain skip — a catastrophic risk we catch and repair early.</p></div></div>
      <div class="prob reveal"><div class="pi"><i data-lucide="droplet"></i></div><div><span class="eng">2.0T TFSI</span><h3>Excessive Oil Consumption</h3><p>Worn piston rings/PCV on early 2.0T engines — diagnosed properly and fixed, not just topped off.</p></div></div>
      <div class="prob reveal"><div class="pi"><i data-lucide="git-commit-horizontal"></i></div><div><span class="eng">DSG · S tronic</span><h3>Mechatronics &amp; Clutch</h3><p>Jerky shifts and fault codes from neglected fluid or a failing mechatronic unit — serviced and repaired.</p></div></div>
      <div class="prob reveal"><div class="pi"><i data-lucide="thermometer"></i></div><div><span class="eng">2.0T TFSI</span><h3>Water Pump &amp; Thermostat</h3><p>The composite water pump/thermostat module is a known failure — replaced with updated OEM parts.</p></div></div>
      <div class="prob reveal"><div class="pi"><i data-lucide="git-fork"></i></div><div><span class="eng">quattro · Haldex</span><h3>Haldex &amp; Driveline Service</h3><p>Neglected Haldex fluid kills all-wheel-drive performance — we service it to keep quattro sharp.</p></div></div>
    </div>
  </div>
</section>

<!-- MODELS -->
<section class="sec models">
  <div class="container">
    <span class="eyebrow">Models We Service</span>
    <h2 class="h2">Every Audi we get our hands on.</h2>
    <div class="chips reveal">
      <span>A3 · S3 · RS3</span><span>A4 · S4</span><span>A5 · S5</span><span>A6 · A7</span><span>A8</span>
      <span>Q3 · Q5</span><span>Q7 · Q8</span><span>TT · TTS</span><span>R8 V10</span><span>e-tron</span>
    </div>
  </div>
</section>

<!-- DEALER COMPARE -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">GCS vs. The Audi Dealer</span>
      <h2 class="h2">Same expertise. Better experience.</h2>
    </div>
    <div class="deal">
      <div class="dcard win reveal">
        <h3>German Car Specialists</h3>
        <div class="sub">The Independent Audi Specialist</div>
        <ul>
          <li><i data-lucide="check"></i><span><b>Typically well below</b> dealer parts &amp; labor rates</span></li>
          <li><i data-lucide="check"></i><span><b>OEM &amp; OE-supplier parts</b> with manufacturer warranties</span></li>
          <li><i data-lucide="check"></i><span><b>Factory-level Audi diagnostics</b> &amp; coding in-house</span></li>
          <li><i data-lucide="check"></i><span><b>Honest, photo-backed</b> inspections you approve</span></li>
          <li><i data-lucide="check"></i><span>Talk directly to the tech working your Audi</span></li>
          <li><i data-lucide="check"></i><span><b>24-month / 24,000-mile</b> repair warranty</span></li>
        </ul>
      </div>
      <div class="dcard lose reveal">
        <h3>The Franchise Dealer</h3>
        <div class="sub">The Old Way</div>
        <ul>
          <li><i data-lucide="x"></i><span>Premium dealer rates on everything</span></li>
          <li><i data-lucide="x"></i><span>Pressure to add services you don't need</span></li>
          <li><i data-lucide="minus"></i><span>Rotating advisors who don't know your car</span></li>
          <li><i data-lucide="x"></i><span>A call center between you and the shop</span></li>
          <li><i data-lucide="x"></i><span>Days-long backlog, booked weeks out</span></li>
          <li><i data-lucide="minus"></i><span>Warranty terms buried in the fine print</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Audi Owners Trust Us</span>
      <h2 class="h2">4.9 stars from San Antonio drivers.</h2>
    </div>
    <div class="rev-grid">
      <div class="rcard feat reveal">
        <div class="rs" data-stars><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></div>
        <p>"My Q5 had a check-engine light three shops couldn't sort out. GCS diagnosed a carbon and PCV issue in an afternoon, walnut-blasted it, and it runs like new. Half the dealer quote."</p>
        <div class="who"><span class="av">JL</span><div><b>Jenna L.</b><span>Audi Q5</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rs" data-stars><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></div>
        <p>"They handle the DSG service on my S4 better than the dealer did — and explain everything with photos. Genuinely know these cars."</p>
        <div class="who"><span class="av">RB</span><div><b>Rafael B.</b><span>Audi S4</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rs" data-stars><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></div>
        <p>"Trusted them with my R8 and they treated it like their own — OEM parts, proper torque specs, clear communication. Hard to find this level outside a dealer."</p>
        <div class="who"><span class="av">MS</span><div><b>Mark S.</b><span>Audi R8 V10</span></div></div>
      </div>
    </div>
    <div class="sec-head" style="margin:44px auto 0"><a class="btn btn-ghost reveal" href="/#reviews"><i data-lucide="star"></i>Read all reviews</a></div>
  </div>
</section>

<!-- BOOKING -->
<section class="sec book" id="book">
  <div class="container">
    <div class="book-shell" style="grid-template-columns:1fr;text-align:center;max-width:720px;margin:0 auto">
      <div class="book-copy reveal">
        <span class="eyebrow" style="justify-content:center">Book · Estimate · Ask</span>
        <h2 class="h2" style="text-align:center">Ready to skip the dealer?</h2>
        <p class="lead" style="margin:16px auto 30px;max-width:54ch">Book a service, ask for an estimate, or just send a question — one quick form, answered the same business day by a real technician at the shop.</p>
        <div class="hero-cta" style="justify-content:center">
          <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
          <a class="btn btn-light" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Audi Repair FAQ</span>
      <h2 class="h2">Questions, answered.</h2>
    </div>
    <div class="faq reveal">
      <details><summary>How much does Audi repair cost in San Antonio?<span class="pl"></span></summary><div class="fa">It depends on the job, but independent Audi repair typically runs well below dealership rates for the same work — often 25–40% less on parts and labor. You'll always get an upfront, itemized estimate to approve before any work begins.</div></details>
      <details><summary>Do you use genuine Audi (OEM) parts?<span class="pl"></span></summary><div class="fa">Yes. We fit OEM or OE-supplier parts — the same components Audi uses — never the cheapest aftermarket box. Every part carries its manufacturer warranty, and our work is backed by a 24-month / 24,000-mile guarantee.</div></details>
      <details><summary>Will servicing my Audi here void my warranty?<span class="pl"></span></summary><div class="fa">No. Under the federal Magnuson-Moss Warranty Act, an independent shop using quality parts can perform your scheduled maintenance and repairs without voiding your factory or extended warranty. We document everything for your records.</div></details>
      <details><summary>Do you do carbon cleaning and DSG service?<span class="pl"></span></summary><div class="fa">Yes — walnut-blasting intake valves to clear carbon on TFSI engines, and full DSG/S tronic fluid &amp; filter service (plus mechatronics repair) are core Audi jobs for us.</div></details>
      <details><summary>Do you work on S, RS and R8 models?<span class="pl"></span></summary><div class="fa">Absolutely — from a daily A4 to S/RS performance cars and the R8 V10. Our technicians are trained across the lineup and we have the factory-level tools to support it.</div></details>
      <details><summary>Where are you located?<span class="pl"></span></summary><div class="fa">We're at 15555 Tradesman Dr, Ste 500, San Antonio, TX 78249, open Mon–Thu 7:30a–5:30p and Fri 7:30a–5:00p.</div></details>
    </div>
  </div>
</section>`;
const JSONLD = `<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"AutoRepair",
  "name":"German Car Specialists",
  "image":"https://mygermancarsa.com/assets/logo-color.png",
  "telephone":"+1-210-399-1172",
  "priceRange":"$$",
  "address":{"@type":"PostalAddress","streetAddress":"15555 Tradesman Dr, Ste 500","addressLocality":"San Antonio","addressRegion":"TX","postalCode":"78249","addressCountry":"US"},
  "areaServed":"San Antonio, TX",
  "aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"325"},
  "openingHours":["Mo-Th 07:30-17:30","Fr 07:30-17:00"]
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":"https://mygermancarsa.com/"},
    {"@type":"ListItem","position":2,"name":"Audi Repair San Antonio","item":"https://mygermancarsa.com/audi-repair-san-antonio"}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Service",
  "serviceType":"Audi Repair & Service",
  "provider":{"@type":"AutoRepair","name":"German Car Specialists","telephone":"+1-210-399-1172","priceRange":"$$","image":"https://mygermancarsa.com/assets/logo-color.png","address":{"@type":"PostalAddress","streetAddress":"15555 Tradesman Dr, Ste 500","addressLocality":"San Antonio","addressRegion":"TX","postalCode":"78249","addressCountry":"US"}},
