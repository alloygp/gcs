---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `German Car Key & Fob Replacement in San Antonio`;
const DESC = `Lost or broken key fob for your BMW, Audi, Mercedes or Porsche? Replacement, programming & battery service in San Antonio — without dealer prices.`;
const CANON = `https://mygermancarsa.com/german-car-key-replacement-san-antonio`;
const SCREEN = `Key & Fob Replacement`;
const BLOG = false;
const DEFAULT_MAKE = undefined;
const STYLE = `.hero-make .keychip{width:46px;height:46px;border-radius:12px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;padding:0;border:0;}
.hero-make .keychip svg{width:24px;height:24px;}
.prose .kw{color:var(--navy);font-weight:700;}
/* make cards */
.km-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
.kmcard{background:#fff;border:1px solid var(--fog);border-radius:12px;padding:26px 22px 20px;display:flex;flex-direction:column;text-align:center;align-items:center;position:relative;overflow:hidden;color:var(--navy);transition:transform .2s var(--ease),border-color .2s,box-shadow .2s;}
.kmcard::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.kmcard:hover{transform:translateY(-4px);border-color:var(--acc);box-shadow:0 16px 36px rgba(12,14,18,.1);}
.kmcard:hover::before{transform:scaleX(1);}
.kmcard .kl{height:44px;display:grid;place-items:center;margin-bottom:13px;}
.kmcard .kl img{max-height:36px;max-width:58px;object-fit:contain;}
.kmcard h3{font-family:var(--font-display);font-size:21px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:5px;}
.kmcard p{font-size:13.5px;color:var(--steel-500);line-height:1.5;margin-bottom:14px;}
.kmcard .kcta{margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:13px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.kmcard .kcta svg{width:14px;height:14px;}
@media(max-width:900px){.km-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:460px){.km-grid{grid-template-columns:1fr;}}`;
const CONTENT = `<!-- BREADCRUMB -->
<div class="crumbbar"><div class="container"><div class="crumb"><a href="/">Home</a><i data-lucide="chevron-right"></i><a href="/#services">Services</a><i data-lucide="chevron-right"></i><span class="cur">Key &amp; Fob Replacement</span></div></div></div>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-copy">
      <div class="hero-make"><span class="keychip"><i data-lucide="key-round"></i></span><span>Key &amp; Fob Service</span></div>
      <h1 class="display">German Car Key &amp; Fob Replacement in <em>San Antonio.</em></h1>
      <p class="lead">Lost or broken key fob for your BMW, Audi, Mercedes or Porsche? We cut, program and replace smart keys and fobs — and swap dead batteries in minutes — at a fraction of dealer pricing. Most keys done same day, right here in San Antonio.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Get a Key Quote</a>
        <a class="btn btn-ghost" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
      </div>
      <div class="hero-mini">
        <div class="hm"><i data-lucide="key-round"></i><span>Cut &amp; programmed in-house</span></div>
        <div class="hm"><i data-lucide="badge-dollar-sign"></i><span>A fraction of dealer cost</span></div>
        <div class="hm"><i data-lucide="zap"></i><span>Most keys same-day</span></div>
      </div>
    </div>
    <div class="hero-vis">
      <div class="frame"><img src="/assets/shop-interior-bays.jpeg" alt="Inside the My German Car SA service shop in San Antonio" width="800" height="470" loading="eager"></div>
      <div class="float">
        <div class="big">4.9</div>
        <div>
          <div class="grow"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.6.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg><b>Google Rating</b></div>
          <div class="gs" id="hero-s"></div><small>Verified Google reviews</small>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee"><div class="track">
  <div class="seg"><b>Key Fobs</b><b>Smart Keys</b><b>Programming &amp; Coding</b><b>Battery Service</b><b>No Dealer Markup</b></div>
  <div class="seg"><b>Key Fobs</b><b>Smart Keys</b><b>Programming &amp; Coding</b><b>Battery Service</b><b>No Dealer Markup</b></div>
</div></div>

<!-- STAT BAND -->
<section class="stats"><div class="container">
  <div class="statc"><b>Same-Day</b><span>Most Keys</span></div>
  <div class="statc"><b>4</b><span>German Marques</span></div>
  <div class="statc"><b>OEM</b><span>Keys &amp; Fobs</span></div>
  <div class="statc"><b>2010</b><span>Independent Since</span></div>
</div></section>

<!-- INTRO -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Key fob replacement, done right</span>
      <h2 class="h2">Don't pay dealer prices for a key.</h2>
    </div>
    <div class="prose reveal">
      <p>Searching for <span class="kw">key fob replacement near me</span> in San&nbsp;Antonio? A lost or failing key doesn't have to mean a trip to the dealership — or a dealer-sized invoice. At <span class="kw">German Car Specialists</span>, we handle <span class="kw">key fob replacement, cutting, programming and battery service</span> for Audi, BMW, Mercedes-Benz and Porsche in-house, using factory-level tools and OEM-quality keys. The same job a dealer schedules a week out and charges a premium for, we often turn around the same day for far less.</p>
      <p>Modern German keys are small computers: every fob has to be cut to your vehicle and electronically coded to its security system before it will start the car. That's why a hardware store can't help and why so many shops send you back to the dealer. We have the equipment to do it properly — whether you need a single spare, a <span class="kw">car key replacement</span> after losing your only fob, or a quick <span class="kw">key fob battery replacement</span> so your remote stops dying in the H-E-B parking lot.</p>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">What we do</span>
      <h2 class="h2">Complete key &amp; fob service.</h2>
      <p class="lead">From a dead battery to all-keys-lost — every German key need, under one roof.</p>
    </div>
    <div class="svc-grid">
      <div class="svc reveal"><div class="ico"><i data-lucide="key-round"></i></div><h3>Key Fob Replacement</h3><p>New OEM-quality fobs cut and supplied for your exact model — at independent pricing, not dealer markup.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="cpu"></i></div><h3>Programming &amp; Coding</h3><p>Smart keys and remotes coded to your car's security system with factory-level equipment.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="battery-charging"></i></div><h3>Fob Battery Replacement</h3><p>Remote acting up or not unlocking? A quick battery swap is often all it needs — done in minutes.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="copy"></i></div><h3>Spare &amp; Duplicate Keys</h3><p>Add a backup before you lose your only key — far cheaper than an emergency all-keys-lost job.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="alert-triangle"></i></div><h3>Lost All Keys</h3><p>Down to no working key? We can generate and program a fresh key to get you back on the road.</p></div>
      <div class="svc reveal"><div class="ico"><i data-lucide="unlock"></i></div><h3>Lost Wheel-Lock Key</h3><p>Misplaced the key for your locking lug nuts? We have the tools to remove and replace them safely.</p></div>
    </div>
  </div>
</section>

<!-- BY MAKE -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Keys for every German marque</span>
      <h2 class="h2">Made for your make.</h2>
      <p class="lead">Each brand uses its own key system and security coding. We're set up for all four — pick yours for model-specific service.</p>
    </div>
    <div class="km-grid">
      <a class="kmcard reveal" href="/bmw-repair-san-antonio">
        <span class="kl"><img src="/assets/marques/bmw.svg" alt="BMW"></span>
        <h3>BMW</h3><p>Comfort Access &amp; display-key replacement, coding and battery service.</p>
        <span class="kcta">BMW Key Fob <i data-lucide="arrow-right"></i></span>
      </a>
      <a class="kmcard reveal" href="/audi-repair-san-antonio">
        <span class="kl"><img src="/assets/marques/audi.svg" alt="Audi"></span>
        <h3>Audi</h3><p>Advanced-key fobs and flip keys cut and programmed to your Audi.</p>
        <span class="kcta">Audi Key Fob <i data-lucide="arrow-right"></i></span>
      </a>
      <a class="kmcard reveal" href="/mercedes-repair-san-antonio">
        <span class="kl"><img src="/assets/marques/mercedes.svg" alt="Mercedes-Benz"></span>
        <h3>Mercedes</h3><p>Keyless-Go smart keys replaced and coded — without the dealer wait.</p>
        <span class="kcta">Mercedes Key Fob <i data-lucide="arrow-right"></i></span>
      </a>
      <a class="kmcard reveal" href="/porsche-repair-san-antonio">
        <span class="kl"><img src="/assets/marques/porsche.svg" alt="Porsche"></span>
        <h3>Porsche</h3><p>Porsche remotes and smart keys supplied, cut and programmed to spec.</p>
        <span class="kcta">Porsche Key Fob <i data-lucide="arrow-right"></i></span>
      </a>
    </div>
  </div>
</section>

<!-- DEALER COMPARE -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">GCS vs. The Dealer</span>
      <h2 class="h2">Same key. Smaller bill.</h2>
    </div>
    <div class="deal">
      <div class="dcard win reveal">
        <h3>German Car Specialists</h3>
        <div class="sub">The Independent Key Specialist</div>
        <ul>
          <li><i data-lucide="check"></i><span><b>Well below</b> dealer key &amp; programming rates</span></li>
          <li><i data-lucide="check"></i><span><b>OEM-quality fobs</b> cut &amp; coded in-house</span></li>
          <li><i data-lucide="check"></i><span>Most keys <b>same or next day</b> — no week-long wait</span></li>
          <li><i data-lucide="check"></i><span>Battery swaps &amp; spares while you wait</span></li>
          <li><i data-lucide="check"></i><span>Honest, upfront quote before any work</span></li>
        </ul>
      </div>
      <div class="dcard lose reveal">
        <h3>The Franchise Dealer</h3>
        <div class="sub">The Old Way</div>
        <ul>
          <li><i data-lucide="x"></i><span>Premium dealer rates on keys &amp; labor</span></li>
          <li><i data-lucide="x"></i><span>Often days to order the blank key</span></li>
          <li><i data-lucide="x"></i><span>Appointment required, vehicle left on site</span></li>
          <li><i data-lucide="minus"></i><span>Add-ons pushed at the service desk</span></li>
          <li><i data-lucide="x"></i><span>A call center between you and the work</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">San Antonio drivers trust us</span>
      <h2 class="h2">4.9 stars, keys included.</h2>
    </div>
    <div class="rev-grid">
      <div class="rcard feat reveal">
        <div class="rs" data-stars></div>
        <p>"BMW dealer wanted a small fortune and a week's wait for a replacement key. GCS had me cut, coded and driving the same afternoon for far less. No-brainer."</p>
        <div class="who"><span class="av">MR</span><div><b>Marcus R.</b><span>BMW 540i</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rs" data-stars></div>
        <p>"My Mercedes remote kept dropping out — turned out to just need a battery and a quick recode. They sorted it in fifteen minutes. Honest shop."</p>
        <div class="who"><span class="av">SP</span><div><b>Sandra P.</b><span>Mercedes E350</span></div></div>
      </div>
      <div class="rcard reveal">
        <div class="rs" data-stars></div>
        <p>"Lost the only key to my Audi. They generated a new one, programmed it, and even made me a spare. Saved me a tow to the dealership."</p>
        <div class="who"><span class="av">JL</span><div><b>Jenna L.</b><span>Audi Q5</span></div></div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="sec alt">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Key &amp; Fob FAQ</span>
      <h2 class="h2">Questions, answered.</h2>
    </div>
    <div class="faq reveal">
      <details><summary>How much does German car key fob replacement cost?<span class="pl"></span></summary><div class="fa">It varies by make and key type, but independent replacement and programming typically runs well below dealer pricing for the same OEM-quality key. You'll get an upfront, all-in quote — key, cutting and coding included — before we start.</div></details>
      <details><summary>Can you program a key fob without going to the dealer?<span class="pl"></span></summary><div class="fa">Yes. We use factory-level diagnostic and key-programming equipment to code smart keys and remotes to your car's security system — the step a hardware store can't do and the reason most shops send you back to the dealer.</div></details>
      <details><summary>My fob just needs a battery — can you do that?<span class="pl"></span></summary><div class="fa">Absolutely. A remote that's slow, intermittent or not unlocking often just needs a fresh battery and a quick recheck. It's a few-minute job and a fraction of the cost of assuming the whole fob has failed.</div></details>
      <details><summary>I lost all my keys — can you still help?<span class="pl"></span></summary><div class="fa">Yes. An all-keys-lost situation takes more work, but we can generate and program a new key to your vehicle. We'll also recommend cutting a spare at the same time so you're never stranded again.</div></details>
      <details><summary>Do BMW, Audi, Mercedes and Porsche keys need special equipment?<span class="pl"></span></summary><div class="fa">They do — each marque uses its own key architecture and security coding. We're set up for all four, including BMW Comfort Access/display keys, Audi advanced keys, Mercedes Keyless-Go and Porsche smart keys.</div></details>
      <details><summary>I lost the key for my wheel locks, not my car — can you help?<span class="pl"></span></summary><div class="fa">Yes. A missing wheel-lock (locking lug nut) key is a common one. We have the proper removal tools to take the locks off safely without damaging your wheels, and we'll supply a replacement set so you're covered.</div></details>
    </div>
  </div>
</section>

<!-- CTA BAND -->
<section class="sec book" id="book">
  <div class="container">
    <div class="book-shell" style="grid-template-columns:1fr;text-align:center;max-width:720px;margin:0 auto">
      <div class="book-copy reveal">
        <span class="eyebrow" style="justify-content:center">Book · Estimate · Ask</span>
        <h2 class="h2" data-make-tpl="Let's get your {make} a new key." style="text-align:center">Need a key or fob sorted?</h2>
        <p class="lead" style="margin:16px auto 30px;max-width:54ch">Tell us your make and what happened — lost, broken, or just a dead battery — and we'll quote it the same business day. No dealer wait, no dealer markup.</p>
        <div class="hero-cta" style="justify-content:center">
          <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Get a Key Quote</a>
          <a class="btn btn-light" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
        </div>
      </div>
    </div>
  </div>
</section>`;
