---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `BMW Carbon Build-Up Cleaning (Walnut Blasting) | San Antonio`;
const DESC = `Rough idle, misfires or lost power? BMW carbon build-up cleaning / walnut blasting in San Antonio, done the right way by German specialists.`;
const CANON = `https://mygermancarsa.com/bmw-carbon-buildup-cleaning-san-antonio`;
