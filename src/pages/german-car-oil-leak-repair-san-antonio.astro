      <div class="hero-cta">
        <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Get a Repair Quote</a>
        <a class="btn btn-ghost" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
      </div>
      <div class="hero-mini">
        <div class="hm"><i data-lucide="search"></i><span>We trace the real source</span></div>
        <div class="hm"><i data-lucide="package-check"></i><span>OEM gaskets &amp; seals</span></div>
        <div class="hm"><i data-lucide="shield-check"></i><span>24-month warranty</span></div>
