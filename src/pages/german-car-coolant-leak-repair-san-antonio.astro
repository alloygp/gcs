---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `German Car Coolant Leak Repair in San Antonio | BMW Audi VW`;
const DESC = `Coolant leak or overheating in your German car? Cooling-system diagnosis & repair in San Antonio — BMW N54 water pumps, hoses, thermostats & more.`;
const CANON = `https://mygermancarsa.com/german-car-coolant-leak-repair-san-antonio`;
const SCREEN = `Coolant Leak Repair`;
const BLOG = false;
const DEFAULT_MAKE = undefined;
const STYLE = `.hero-make .keychip{width:46px;height:46px;border-radius:12px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;padding:0;border:0;}
.hero-make .keychip svg{width:24px;height:24px;}
.prose .kw{color:var(--navy);font-weight:700;}
/* make cards */
.km-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
.kmcard{background:#fff;border:1px solid var(--fog);border-radius:12px;padding:26px 22px 20px;display:flex;flex-direction:column;text-align:center;align-items:center;position:relative;overflow:hidden;color:var(--navy);transition:transform .2s var(--ease),border-color .2s,box-shadow .2s;}
.kmcard::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.kmcard:hover{transform:translateY(-4px);border-color:var(--acc);box-shadow:0 16px 36px rgba(12,14,18,.1);}
.kmcard:hover::before{transform:scaleX(1);}
.kmcard .kl{height:44px;display:grid;place-items:center;margin-bottom:13px;}
.kmcard .kl img{max-height:36px;max-width:58px;object-fit:contain;}
.kmcard h3{font-family:var(--font-display);font-size:21px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:5px;}
.kmcard p{font-size:13.5px;color:var(--steel-500);line-height:1.5;margin-bottom:14px;}
.kmcard .kcta{margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:13px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.kmcard .kcta svg{width:14px;height:14px;}
@media(max-width:900px){.km-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:460px){.km-grid{grid-template-columns:1fr;}}
/* N54 hook */
.n54{background:var(--navy);color:#fff;border-radius:16px;padding:clamp(30px,4vw,48px);position:relative;overflow:hidden;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;}
.n54::before{content:"";position:absolute;top:0;left:0;bottom:0;width:4px;background:var(--acc);}
.n54 .eyebrow{color:var(--acc-mid);margin-bottom:14px;}
.n54 .eyebrow::before{background:var(--acc-mid);}
.n54 h2{font-family:var(--font-display);font-size:clamp(26px,3vw,38px);font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:#fff;margin:0 0 14px;line-height:1.04;}
.n54 p{font-size:16px;line-height:1.65;color:rgba(255,255,255,.82);margin:0 0 14px;}
.n54 p:last-child{margin:0;}
.n54 .fail{display:flex;flex-direction:column;gap:12px;}
.n54 .fail li{display:flex;gap:12px;align-items:flex-start;font-size:15px;color:rgba(255,255,255,.9);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:14px 16px;}
.n54 .fail li svg{width:20px;height:20px;color:var(--acc-mid);flex:none;margin-top:1px;}
.n54 .fail li b{color:#fff;font-weight:700;}
.n54 a.inline{color:var(--acc-mid);font-weight:700;border-bottom:1px solid rgba(216,18,34,.4);}
@media(max-width:820px){.n54{grid-template-columns:1fr;gap:26px;}}`;
const CONTENT = `<!-- BREADCRUMB -->
<div class="crumbbar"><div class="container"><div class="crumb"><a href="/">Home</a><i data-lucide="chevron-right"></i><a href="/#services">Services</a><i data-lucide="chevron-right"></i><span class="cur">Coolant Leak Repair</span></div></div></div>

