@media(max-width:600px){.carbar .cb-label{width:100%;}.carbar .cb-reset{margin-left:0;}}


/* Why Us card dropdown (compact, mtile-style) */
.nav .menu.cards{left:50%;min-width:440px;padding:18px 20px 22px;display:grid;grid-template-columns:1fr 1fr;gap:14px;transform:translateX(-50%) translateY(8px);border:none;border-top:1px solid var(--fog);border-radius:0 0 14px 14px;box-shadow:0 28px 48px rgba(12,14,18,.14);}
.nav .has-menu:hover .menu.cards,.nav .has-menu.open .menu.cards{opacity:1;visibility:visible;transform:translateX(-50%) translateY(27px);}
.nav .has-menu.open>a svg{transform:rotate(180deg);}
.nav .menu.cards .ctile{background:#fff;border:1px solid var(--fog);border-radius:10px;padding:24px 22px 20px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;position:relative;overflow:hidden;color:var(--navy);text-decoration:none;transition:transform .18s var(--ease),border-color .18s,box-shadow .18s;}
.nav .menu.cards .ctile:hover{background:#fff;transform:translateY(-3px);border-color:var(--acc);box-shadow:0 12px 28px rgba(12,14,18,.1);}
.nav .menu.cards .ctile::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.nav .menu.cards .ctile:hover::before{transform:scaleX(1);}
.nav .menu.cards .ctile .ctile-ic{width:40px;height:40px;border-radius:10px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;margin-bottom:11px;}
