.ftr .ct svg{width:16px;height:16px;color:var(--acc-mid);flex:none;margin-top:2px;}
.ftr-bottom{display:flex;justify-content:space-between;padding:22px 0;font-size:12px;color:rgba(255,255,255,.5);flex-wrap:wrap;gap:8px;}
@media(max-width:860px){.ftr-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:520px){.ftr-grid{grid-template-columns:1fr;}}

/* drawer */
.drawer{position:fixed;inset:0;z-index:90;background:rgba(255,255,255,.98);backdrop-filter:blur(8px);display:flex;flex-direction:column;padding:26px;transform:translateX(100%);transition:transform .3s var(--ease);}
.drawer.open{transform:none;}
