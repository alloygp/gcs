---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `German & European Auto Repair in San Antonio`;
const DESC = `Independent Audi, BMW, Mercedes & Porsche repair in San Antonio — dealer-level service without dealer prices. Carfax Top-Rated. Book online today.`;
const CANON = `https://mygermancarsa.com/`;
const SCREEN = `GCS Homepage`;
const BLOG = false;
const DEFAULT_MAKE = undefined;
const STYLE = `/* ============ DESIGN 3 · CLEAN / TRUST-FIRST ============ */
:root{
  --acc:#AF0D19;          /* GCS crimson */
  --acc-d:#850A13;        /* red pressed */
  --acc-soft:#fbe7e9;     /* faint red tint */
  --acc-mid:#D81222;      /* red bright (on dark) */
  --navy:#15181d;         /* near-black charcoal */
  --font-display:'Saira Condensed','Arial Narrow',sans-serif;
  --font-body:'Archivo','Gotham','Helvetica Neue',Arial,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;
}
body{background:var(--white);color:var(--steel-900);font-size:17px;line-height:1.6;font-family:var(--font-body);}
.wrap{overflow-x:clip;}
section{position:relative;}
.container{max-width:1220px;}

h1,h2,h3{font-weight:900;letter-spacing:-.025em;line-height:1.02;color:var(--navy);}
.brand img{height:42px;width:auto;display:block;}
.eyebrow{font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);
  display:inline-flex;align-items:center;gap:11px;}
.eyebrow::before{content:"";width:26px;height:2px;background:var(--acc);}
.display{font-family:var(--font-display);font-size:clamp(38px,4.8vw,66px);font-weight:900;letter-spacing:-.015em;line-height:1.0;text-transform:uppercase;text-wrap:balance;}
.h2{font-family:var(--font-display);font-size:clamp(34px,4.4vw,58px);font-weight:800;letter-spacing:-.01em;}
.lead{font-size:clamp(18px,1.4vw,21px);color:var(--steel-500);font-weight:400;line-height:1.62;}

.btn{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:13px;letter-spacing:.08em;text-transform:uppercase;
  padding:16px 26px;border-radius:6px;transition:transform .15s var(--ease),background .15s,box-shadow .15s;border:2px solid transparent;}
.btn svg{width:18px;height:18px;}
.btn-primary{background:var(--acc);color:#fff;box-shadow:0 10px 26px rgba(175,13,25,.24);}
.btn-primary:hover{background:var(--acc-d);transform:translateY(-2px);}
.btn-ghost{background:#fff;color:var(--navy);border-color:var(--fog);}
.btn-ghost:hover{border-color:var(--acc);color:var(--acc);}
.btn-light{background:#fff;color:var(--acc);}
.btn-light:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(0,0,0,.16);}

/* topbar */
.topbar{background:var(--navy);color:rgba(255,255,255,.8);font-size:13px;}
.topbar .container{display:flex;justify-content:space-between;align-items:center;height:40px;gap:18px;}
.topbar .tl{display:flex;gap:24px;}
.topbar .tl span{display:inline-flex;align-items:center;gap:7px;}
.topbar .tl svg{width:14px;height:14px;color:var(--acc-mid);}
.topbar .tr{display:inline-flex;align-items:center;gap:8px;font-weight:600;}
.topbar .tr .gs{color:var(--star);display:inline-flex;gap:1px;}
.topbar .tr .gs svg{width:13px;height:13px;fill:var(--star);stroke:none;}
@media(max-width:820px){.topbar .tl span:not(:first-child){display:none;}}

/* header */
.hdr{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--fog);transition:transform .38s cubic-bezier(.4,0,.2,1),background-color .3s ease,box-shadow .3s ease;will-change:transform;}
.hdr.is-hidden{transform:translateY(-100%);}
.hdr.is-glass{background:rgba(255,255,255,.62);backdrop-filter:blur(20px) saturate(140%);box-shadow:0 10px 30px rgba(12,14,18,.08);}
.hdr .container{display:flex;align-items:center;gap:34px;height:78px;}
.brand{display:flex;align-items:center;gap:12px;}
.brand .mk{width:44px;height:44px;border-radius:12px;background:var(--acc);color:#fff;display:grid;place-items:center;font-weight:800;font-size:19px;letter-spacing:-.03em;box-shadow:0 6px 16px rgba(175,13,25,.25);}
.brand b{font-weight:800;font-size:17px;color:var(--navy);letter-spacing:-.01em;line-height:1;}
.brand small{display:block;font-size:11px;letter-spacing:.1em;color:var(--steel-400);text-transform:uppercase;margin-top:3px;}
.nav{display:flex;gap:30px;margin-left:6px;}
.nav a{font-size:15px;font-weight:500;color:var(--steel-700);transition:color .15s;}
.nav a:hover{color:var(--acc);}
.nav .has-menu{position:relative;display:flex;align-items:center;}
.nav .has-menu>a{display:inline-flex;align-items:center;gap:5px;cursor:pointer;}
.nav .has-menu>a svg{width:14px;height:14px;transition:transform .18s var(--ease);}
.nav .has-menu:hover>a svg{transform:rotate(180deg);}
.nav .menu{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(8px);min-width:242px;background:#fff;border:1px solid var(--fog);border-radius:12px;box-shadow:0 18px 44px rgba(12,14,18,.16);padding:8px;opacity:0;visibility:hidden;transition:opacity .18s var(--ease),transform .18s var(--ease);z-index:60;}
.nav .menu::before{content:"";position:absolute;top:-16px;left:0;right:0;height:16px;}
.nav .has-menu:hover .menu{opacity:1;visibility:visible;transform:translateX(-50%) translateY(12px);}
.nav .menu a{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;border-radius:8px;font-size:14px;font-weight:600;color:var(--navy);}
.nav .menu a:hover{background:var(--acc-soft);color:var(--acc);}
.nav .menu a span{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--steel-400);}
.nav .menu a .mq{display:flex;align-items:center;gap:10px;font-family:inherit;font-size:14px;font-weight:600;letter-spacing:normal;text-transform:none;color:var(--navy);}
.nav .has-menu .menu{min-width:268px;}
.nav .menu .mqi{width:30px;height:24px;display:grid;place-items:center;flex:none;}
.nav .menu .mqi img{max-width:26px;max-height:22px;object-fit:contain;display:block;}
.nav .menu.wide{min-width:286px;}
/* Makes mega-menu — full-width dark panel flush under the header border */
.nav .has-mega{position:static;display:flex;align-items:center;}
.nav .has-mega>a{display:inline-flex;align-items:center;gap:5px;cursor:pointer;}
.nav .has-mega>a svg{width:14px;height:14px;transition:transform .18s var(--ease);}
.nav .has-mega.open>a svg{transform:rotate(180deg);}
.nav .menu.mega{left:0;right:0;width:100%;min-width:0;padding:0;background:#fff;
  border:none;border-radius:0;border-top:1px solid var(--fog);
  box-shadow:0 28px 48px rgba(12,14,18,.14);transform:translateY(8px);}
.nav .has-mega.open .menu.mega{opacity:1;visibility:visible;transform:translateY(0);}
.nav .menu.mega::before{display:none;}
.mega-inner{max-width:1220px;margin:0 auto;padding:26px 28px 30px;}
.mega-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.mtile{background:#fff;border:1px solid var(--fog);border-radius:10px;
  padding:24px 22px 20px;display:flex;flex-direction:column;align-items:center;text-align:center;
  position:relative;overflow:hidden;color:var(--navy);text-decoration:none;transition:transform .18s var(--ease),border-color .18s,box-shadow .18s;}
.mtile::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.mtile:hover{transform:translateY(-3px);border-color:var(--acc);box-shadow:0 12px 28px rgba(12,14,18,.1);}
.mtile:hover::before{transform:scaleX(1);}
.mtile .mtile-logo{height:48px;display:grid;place-items:center;margin-bottom:14px;}
.mtile .mtile-logo img{max-height:40px;max-width:62px;object-fit:contain;}
.mtile h3{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-size:23px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:6px;color:var(--navy);}
.mtile .mtile-sub{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:var(--steel-400);margin-bottom:16px;}
.mtile .mtile-cta{margin-top:auto;display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:700;
  letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:14px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.mtile .mtile-cta svg{width:14px;height:14px;}
.hdr-r{margin-left:auto;display:flex;align-items:center;gap:18px;}
.hdr-phone{font-weight:700;color:var(--navy);display:inline-flex;align-items:center;gap:8px;font-size:15px;}
.hdr-phone svg{width:16px;height:16px;color:var(--acc);}
.burger{display:none;background:#fff;border:1px solid var(--fog);border-radius:10px;width:46px;height:46px;color:var(--navy);place-items:center;}
@media(max-width:980px){.nav,.hdr-phone{display:none;}.burger{display:grid;}}

/* hero */
.hero{background:linear-gradient(180deg,#f4f6f9 0%,#fff 82%);padding:clamp(24px,3vw,46px) 0 clamp(44px,5vw,72px);overflow:hidden;}
.hero .container{display:grid;grid-template-columns:1.04fr .96fr;gap:56px;align-items:center;}
.hero-copy .pill{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--fog);border-radius:99px;
  padding:7px 16px 7px 8px;margin-bottom:24px;box-shadow:var(--shadow-sm,0 2px 6px rgba(0,0,0,.05));}
.hero-copy .pill .gs{display:inline-flex;gap:1px;color:var(--star);}
.hero-copy .pill .gs svg{width:15px;height:15px;fill:var(--star);stroke:none;}
.hero-copy .pill b{font-size:13px;font-weight:700;color:var(--navy);}
.hero-copy .pill span{font-size:13px;color:var(--steel-500);}
.hero-copy .display{margin:0 0 22px;}
.hero-copy .display em{color:var(--acc);font-style:normal;}
.hero-copy .display .slash{display:inline-block;width:64px;height:8px;background:var(--acc);vertical-align:middle;margin:0 0 14px;}
.hero-copy .lead{max-width:40ch;margin-bottom:32px;}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;}
.hero-mini{display:flex;gap:26px;margin-top:34px;flex-wrap:wrap;}
.hero-mini .hm{display:flex;align-items:center;gap:11px;}
.hero-mini .hm svg{width:20px;height:20px;color:var(--acc);flex:none;}
.hero-mini .hm span{font-size:14px;font-weight:600;color:var(--steel-700);}
.hero-mini .hm .hm-uber{width:20px;height:20px;border-radius:4px;flex:none;display:block;}
/* hero visual */
.hero-vis{position:relative;}
.hero-vis .frame{border-radius:16px;overflow:hidden;box-shadow:0 30px 70px rgba(12,14,18,.22);}
.hero-vis image-slot{width:100%;height:460px;display:block;}
.hero-vis .hero-cards{position:absolute;left:12px;right:12px;bottom:12px;display:grid;grid-template-columns:2fr 3fr;gap:12px;align-items:stretch;}
.hero-vis .hcard{background:#fff;border-radius:12px;box-shadow:0 14px 38px rgba(12,14,18,.26);overflow:hidden;}
.hero-vis .hcard-rev{padding:16px 18px;display:flex;flex-direction:column;justify-content:center;gap:5px;}
.hero-vis .hcard-rev .rev-head{display:flex;align-items:center;gap:8px;}
.hero-vis .hcard-rev .rev-head b{font-size:12px;font-weight:700;color:var(--navy);letter-spacing:.01em;}
.hero-vis .hcard-rev .rev-score{font-family:var(--font-display);font-size:42px;font-weight:900;line-height:1;color:var(--navy);letter-spacing:-.02em;}
.hero-vis .hcard-rev .gs{display:flex;gap:2px;color:var(--star);}
.hero-vis .hcard-rev .gs svg{width:17px;height:17px;fill:var(--star);stroke:none;}
.hero-vis .hcard-rev small{font-size:12px;color:var(--steel-500);}
.hero-vis .hcard-map{position:relative;padding:0;overflow:hidden;}
.hero-vis .hcard-map .map{position:absolute;top:-32px;left:0;width:100%;height:calc(100% + 32px);border:0;display:block;}
@media(max-width:920px){.hero .container{grid-template-columns:1fr;}.hero-vis{margin-top:10px;}.hero-vis image-slot{height:340px;}}
/* Mobile: take the review/map cards out of the photo overlay and stack them full-width below it
   (a 40/60 bar is too cramped on a phone — matches the design's mobile intent). */
@media(max-width:600px){
  .hero-vis .hero-cards{position:static;left:auto;right:auto;bottom:auto;grid-template-columns:1fr;gap:10px;margin-top:12px;}
  .hero-vis .hcard{box-shadow:0 8px 22px rgba(12,14,18,.12);}
  .hero-vis .hcard-rev{padding:14px 16px;flex-direction:row;align-items:center;gap:14px;flex-wrap:wrap;}
  .hero-vis .hcard-rev .rev-score{font-size:38px;}
  .hero-vis .hcard-map{height:188px;}
}

/* trust band */
.tband{border-bottom:1px solid var(--fog);background:#fff;}
.tband .container{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 28px;flex-wrap:wrap;}
.tband .tg{display:flex;align-items:center;gap:14px;}
.tband .tg .gicon{width:42px;height:42px;border-radius:50%;border:1px solid var(--fog);display:grid;place-items:center;font-weight:800;font-size:20px;color:#4285F4;}
.tband .tg .gs{display:flex;gap:2px;color:var(--star);}
.tband .tg .gs svg{width:16px;height:16px;fill:var(--star);stroke:none;}
.tband .tg b{font-size:18px;font-weight:800;color:var(--navy);}
.tband .tg small{font-size:13px;color:var(--steel-500);display:block;}
.tband .marqs{display:flex;gap:clamp(16px,2.6vw,40px);align-items:center;flex-wrap:wrap;}
.tband .marqs b{font-weight:800;font-size:clamp(14px,1.4vw,18px);color:var(--steel-400);transition:color .2s;}
.tband .marqs b:hover{color:var(--navy);}
@media(max-width:760px){.tband .marqs{display:none;}}

/* marquee (bold) */
.marquee{background:var(--acc);color:#fff;overflow:hidden;padding:13px 0;}
.marquee .track{display:flex;width:max-content;animation:gcsscroll 32s linear infinite;}
.marquee .seg{display:flex;align-items:center;}
.marquee b{font-weight:900;font-size:18px;text-transform:uppercase;letter-spacing:.03em;padding:0 28px;display:inline-flex;align-items:center;gap:28px;}
.marquee b::after{content:"";width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.65);}
@keyframes gcsscroll{to{transform:translateX(-50%);}}

/* stat band (bold dark) */
.stats{background:var(--navy);}
.stats .container{display:grid;grid-template-columns:repeat(3,1fr);}
.statc{padding:46px 22px;text-align:center;border-right:1px solid rgba(255,255,255,.1);}
.statc:last-child{border-right:none;}
.statc b{display:block;font-weight:900;font-size:clamp(38px,4.4vw,58px);line-height:1;color:var(--acc-mid);letter-spacing:-.02em;}
.statc b .r{color:var(--acc-mid);}
.statc span{display:block;margin-top:11px;font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.55);}
@media(max-width:600px){.stats .container{grid-template-columns:1fr;}.statc{border-right:none;border-bottom:1px solid rgba(255,255,255,.1);}.statc:last-child{border-bottom:none;}}

/* section */
.sec{padding:clamp(64px,8vw,116px) 0;}
.sec-head{text-align:center;max-width:760px;margin:0 auto 58px;}
.sec-head .h2{margin:16px 0 18px;}
.sec-head .lead{margin:0 auto;}
.sec-head.left{text-align:left;margin-left:0;max-width:720px;}
.sec-head.left .eyebrow{justify-content:flex-start;}
.sec-head.left .lead{margin:0;}
.sec.alt{background-color:var(--paper);background-image:var(--paper-tex);}

/* reviews (trust-first, high up) */
.rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.rcard{background:#fff;border:1px solid var(--fog);border-radius:12px;padding:30px;display:flex;flex-direction:column;gap:16px;
  transition:transform .2s var(--ease),box-shadow .2s;}
.rcard:hover{transform:translateY(-4px);box-shadow:0 20px 44px rgba(12,14,18,.1);}
.rcard.feat{background:var(--navy);color:#fff;border-color:var(--navy);position:relative;overflow:hidden;}
.rcard.feat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--acc);}
.rcard .rs{display:flex;gap:3px;color:var(--star);}
.rcard .rs svg{width:18px;height:18px;fill:var(--star);stroke:none;}
.rcard p{font-size:16px;color:var(--steel-700);font-weight:400;line-height:1.62;flex:1;}
.rcard.feat p{color:rgba(255,255,255,.94);font-size:18px;font-weight:500;}
.rcard .who{display:flex;align-items:center;gap:12px;padding-top:16px;border-top:1px solid var(--fog);}
.rcard.feat .who{border-color:rgba(255,255,255,.2);}
.rcard .av{width:42px;height:42px;border-radius:50%;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;font-weight:800;font-size:15px;}
.rcard.feat .av{background:rgba(255,255,255,.16);color:#fff;}
.rcard .who b{font-size:15px;font-weight:700;color:var(--navy);display:block;}
.rcard.feat .who b{color:#fff;}
.rcard .who span{font-size:13px;color:var(--steel-400);}
.rcard.feat .who span{color:rgba(255,255,255,.7);}
.rev-cta{text-align:center;margin-top:44px;}
@media(max-width:920px){.rev-grid{grid-template-columns:1fr;}}

/* dealer compare */
.deal{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
.dcard{border-radius:12px;padding:40px 36px;border:1px solid var(--fog);}
.dcard.win{background:linear-gradient(155deg,rgba(17,19,21,.90) 0%,rgba(17,19,21,.95) 55%,rgba(17,19,21,.98) 100%),url('/assets/photo-r8-engine.webp') center/cover no-repeat;color:#fff;border-color:var(--navy);box-shadow:0 24px 56px rgba(12,14,18,.24);position:relative;overflow:hidden;}
.dcard h3{font-size:24px;margin-bottom:6px;}
.dcard.win h3{color:#fff;}
.dcard .sub{font-size:14px;color:var(--steel-400);margin-bottom:26px;}
.dcard.win .sub{color:var(--acc-mid);font-weight:700;}
.dcard ul{display:flex;flex-direction:column;gap:16px;}
.dcard li{display:flex;gap:13px;align-items:flex-start;font-size:16px;line-height:1.45;}
.dcard li svg{width:22px;height:22px;flex:none;margin-top:1px;}
.dcard.win li svg{color:var(--acc-mid);}
.dcard.win li{color:rgba(255,255,255,.92);}
.dcard.lose li{color:var(--steel-500);}
.dcard.lose li svg{color:var(--steel-300);}
@media(max-width:720px){.deal{grid-template-columns:1fr;}}

/* services */
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;counter-reset:svc;}
.svc{position:relative;overflow:hidden;background:#fff;border:1px solid var(--fog);border-radius:12px;padding:32px;transition:transform .2s var(--ease),box-shadow .2s,border-color .2s;counter-increment:svc;}
.svc::after{content:counter(svc,decimal-leading-zero);position:absolute;top:20px;right:24px;font-family:var(--font-display);font-size:30px;font-weight:800;line-height:1;color:var(--fog);transition:color .2s;pointer-events:none;}
.svc:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(12,14,18,.1);border-color:var(--acc);}
.svc:hover::after{color:var(--acc);}
.svc .ico{width:54px;height:54px;border-radius:14px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;margin-bottom:22px;transition:background .2s,color .2s;}
.svc:hover .ico{background:var(--acc);color:#fff;}
.svc .ico svg{width:27px;height:27px;}
.svc h3{font-size:21px;margin-bottom:10px;}
.svc p{font-size:15px;color:var(--steel-500);font-weight:400;line-height:1.6;}
@media(max-width:920px){.svc-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:600px){.svc-grid{grid-template-columns:1fr;}}

/* by-make selector */
.makes-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.makecard{background:#fff;border:1px solid var(--fog);border-radius:12px;padding:30px 26px 24px;display:flex;flex-direction:column;text-align:center;align-items:center;position:relative;overflow:hidden;color:var(--navy);transition:transform .2s var(--ease),border-color .2s,box-shadow .2s;}
.makecard::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.makecard:hover{transform:translateY(-4px);border-color:var(--acc);box-shadow:0 18px 40px rgba(12,14,18,.1);}
.makecard:hover::before{transform:scaleX(1);}
.makecard .ml{height:50px;display:grid;place-items:center;margin-bottom:16px;}
.makecard .ml img{max-height:42px;max-width:64px;object-fit:contain;}
.makecard h3{font-family:var(--font-display);font-size:24px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:5px;}
.makecard .mline{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--steel-400);margin-bottom:14px;}
.makecard p{font-size:14px;color:var(--steel-500);font-weight:400;line-height:1.55;margin-bottom:18px;}
.makecard .mcta{margin-top:auto;display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:16px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.makecard .mcta svg{width:15px;height:15px;}
@media(max-width:900px){.makes-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:480px){.makes-grid{grid-template-columns:1fr;}}
/* dark section variant (used as a mid-page anchor band) */
.sec.dark{background:var(--navy);color:#fff;}
.sec.dark .sec-head .h2,.sec.dark h2{color:#fff;}
.sec.dark .eyebrow{color:var(--acc-mid);}
.sec.dark .eyebrow::before{background:var(--acc-mid);}
.sec.dark .lead{color:rgba(255,255,255,.72);}
.sec.dark .makecard{background-color:var(--navy);background-image:linear-gradient(160deg,rgba(21,24,29,.80),rgba(21,24,29,.94)),var(--mkimg,none);background-size:cover;background-position:center;border-color:rgba(255,255,255,.12);color:#fff;}
.sec.dark .makecard .ml{background:#fff;border-radius:10px;padding:9px 16px;height:auto;min-height:46px;}
.sec.dark .makecard h3{color:#fff;}
.sec.dark .makecard .mline{color:rgba(255,255,255,.5);}
.sec.dark .makecard p{color:rgba(255,255,255,.64);}
.sec.dark .makecard .mcta{color:var(--acc-mid);border-top-color:rgba(255,255,255,.14);}
.sec.dark .makecard:hover{background-image:linear-gradient(160deg,rgba(21,24,29,.62),rgba(21,24,29,.88)),var(--mkimg,none);border-color:var(--acc-mid);}

/* work gallery strip */
.gallery{padding:clamp(60px,7vw,104px) 0 0;}
.gallery .gallery-head{margin-bottom:40px;}
.gallery .gallery-head .h2{margin:14px 0 14px;}
.gallery .gwrap{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;}
.gallery image-slot,.gallery img{width:100%;height:300px;display:block;background:var(--mist);object-fit:cover;}
@media(max-width:900px){.gallery .gwrap{grid-template-columns:repeat(2,1fr);}.gallery image-slot,.gallery img{height:230px;}}
@media(max-width:520px){.gallery .gwrap{grid-template-columns:1fr;}}

/* why band w/ photo */
.why{background-color:var(--paper);background-image:var(--paper-tex);}
.why .container{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
.why-vis{border-radius:16px;overflow:hidden;box-shadow:0 24px 56px rgba(12,14,18,.16);}
.why-vis image-slot,.why-vis img{width:100%;height:480px;display:block;object-fit:cover;}
.why-vis .why-slides{position:relative;width:100%;height:480px;}
.why-vis .why-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.1s ease;}
.why-vis .why-slide.is-active{opacity:1;}
.why-list{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:34px;}
.wl{display:flex;flex-direction:column;gap:8px;}
.wl .ico{width:44px;height:44px;border-radius:12px;background:#fff;border:1px solid var(--fog);display:grid;place-items:center;color:var(--acc);}
.wl .ico svg{width:22px;height:22px;}
.wl b{font-size:16px;font-weight:800;color:var(--navy);}
.wl span{font-size:14px;color:var(--steel-500);font-weight:400;line-height:1.5;}
@media(max-width:900px){.why .container{grid-template-columns:1fr;}.why-vis{order:-1;}.why-vis image-slot,.why-vis img{height:320px;}.why-vis .why-slides{height:320px;}}
@media(max-width:480px){.why-list{grid-template-columns:1fr;}}

/* booking */
.book{background:var(--navy);color:#fff;}
.book-shell{display:grid;grid-template-columns:.92fr 1.08fr;gap:50px;align-items:start;}
.book-copy .eyebrow{color:var(--acc-mid);}
.book-copy .eyebrow::before{background:var(--acc-mid);}
.book-copy h2{color:#fff;margin:16px 0 18px;}
.book-copy .lead{color:rgba(255,255,255,.74);}
.book-list{margin-top:30px;display:flex;flex-direction:column;gap:16px;}
.book-list li{display:flex;gap:13px;align-items:center;font-size:16px;color:rgba(255,255,255,.9);font-weight:500;}
.book-list svg{width:22px;height:22px;color:var(--acc-mid);flex:none;}
.embed{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 40px 90px rgba(0,0,0,.4);color:var(--navy);}
.embed .eb-bar{display:flex;align-items:center;gap:12px;padding:18px 24px;border-bottom:1px solid var(--fog);}
.embed .eb-bar .sm{width:30px;height:30px;border-radius:8px;background:var(--acc);color:#fff;display:grid;place-items:center;}
.embed .eb-bar .sm svg{width:17px;height:17px;}
.embed .eb-bar b{font-size:15px;font-weight:800;}
.embed .eb-bar .sec-lk{margin-left:auto;font-size:12px;color:var(--steel-400);display:inline-flex;align-items:center;gap:5px;}
.embed .eb-bar .sec-lk svg{width:13px;height:13px;}
.embed .eb-body{padding:32px;}
.sm-form{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.sm-form .full{grid-column:1/-1;}
.sm-field{display:flex;flex-direction:column;gap:7px;}
.sm-field label{font-size:12px;font-weight:700;color:var(--steel-700);letter-spacing:.02em;}
.sm-field input,.sm-field select{border:1.5px solid var(--fog);border-radius:10px;padding:14px;font-family:var(--font);font-size:15px;font-weight:500;color:var(--navy);transition:border-color .15s,box-shadow .15s;}
.sm-field input:focus,.sm-field select:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--acc-soft);}
.sm-form .btn{width:100%;justify-content:center;}
.embed .note{text-align:center;font-size:12px;color:var(--steel-400);padding:0 0 22px;}
@media(max-width:860px){.book-shell{grid-template-columns:1fr;}.sm-form{grid-template-columns:1fr;}}

/* footer */
.ftr{background:var(--navy);color:rgba(255,255,255,.72);padding:72px 0 0;}
.ftr-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:54px;border-bottom:1px solid rgba(255,255,255,.1);}
.ftr .brand b{color:#fff;}
.ftr p{font-size:14px;line-height:1.7;color:rgba(255,255,255,.6);font-weight:400;max-width:32ch;margin-top:16px;}
.ftr h4{font-size:13px;font-weight:800;letter-spacing:.04em;color:#fff;margin-bottom:18px;}
.ftr ul{display:flex;flex-direction:column;gap:11px;}
.ftr ul a{font-size:14px;color:rgba(255,255,255,.66);transition:color .15s;}
.ftr ul a:hover{color:var(--acc-mid);}
.ftr .ct{display:flex;gap:10px;align-items:flex-start;font-size:14px;margin-bottom:12px;color:rgba(255,255,255,.78);}
.ftr .ct svg{width:16px;height:16px;color:var(--acc-mid);flex:none;margin-top:2px;}
.ftr-bottom{display:flex;justify-content:space-between;padding:22px 0;font-size:12px;color:rgba(255,255,255,.5);flex-wrap:wrap;gap:8px;}
@media(max-width:860px){.ftr-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:520px){.ftr-grid{grid-template-columns:1fr;}}

/* drawer */
.drawer{position:fixed;inset:0;z-index:90;background:rgba(255,255,255,.98);backdrop-filter:blur(8px);display:flex;flex-direction:column;padding:26px;transform:translateX(100%);transition:transform .3s var(--ease);}
.drawer.open{transform:none;}
.drawer .dh{display:flex;justify-content:space-between;align-items:center;margin-bottom:36px;}
.drawer .dx{background:#fff;border:1px solid var(--fog);border-radius:10px;width:46px;height:46px;color:var(--navy);display:grid;place-items:center;}
.drawer a{color:var(--navy);font-size:24px;font-weight:800;letter-spacing:-.01em;padding:16px 0;border-bottom:1px solid var(--fog);}
.drawer .btn{margin-top:24px;justify-content:center;}

/* car-picker bar (persists choice site-wide, personalizes soft copy only) */
.carbar{background:var(--paper);border-bottom:1px solid var(--fog);}
.carbar .container{display:flex;align-items:center;gap:18px;padding:11px 0;flex-wrap:wrap;}
.carbar .cb-label{display:inline-flex;align-items:center;gap:9px;font-size:13px;font-weight:700;color:var(--navy);}
.carbar .cb-label svg{width:17px;height:17px;color:var(--acc);}
.carbar .cb-chips{display:flex;gap:8px;flex-wrap:wrap;}
.carbar .cb-chip{display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border:1px solid var(--fog);border-radius:999px;background:#fff;font-family:var(--font-body);font-size:13px;font-weight:700;color:var(--navy);cursor:pointer;transition:border-color .15s,background .15s,box-shadow .15s;}
.carbar .cb-chip img{height:15px;width:auto;}
.carbar .cb-chip:hover{border-color:var(--acc);}
.carbar .cb-chip.active{border-color:var(--acc);background:var(--acc-soft);box-shadow:0 0 0 2px rgba(175,13,25,.12);}
.carbar .cb-reset{margin-left:0;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;border:1px solid var(--fog);background:#fff;color:var(--steel-500);cursor:pointer;transition:border-color .15s,color .15s;}
.carbar .cb-reset svg{width:14px;height:14px;}
.carbar .cb-reset:hover{color:var(--acc);border-color:var(--acc);}
.carbar .cb-reset[hidden]{display:none!important;}
.carbar.chosen .cb-chip:not(.active){display:none;}
@media(max-width:600px){.carbar .cb-label{width:100%;}.carbar .cb-reset{margin-left:0;}}


/* Why Us card dropdown (compact, mtile-style) */
.nav .menu.cards{left:50%;width:780px;min-width:780px;padding:16px;display:grid;grid-template-columns:1fr 1fr 1.6fr;gap:14px;align-items:stretch;transform:translateX(-50%) translateY(8px);border:none;border-top:1px solid var(--fog);border-radius:0 0 14px 14px;box-shadow:0 28px 48px rgba(12,14,18,.14);}
.nav .menu.cards .why-cards{display:contents;}
.nav .menu.cards .why-cred{display:block;border:1px solid var(--fog);border-radius:10px;overflow:hidden;transition:border-color .18s,box-shadow .18s;}
.nav .menu.cards .why-cred:hover{border-color:var(--acc);box-shadow:0 12px 28px rgba(12,14,18,.1);}
.nav .menu.cards .why-cred img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;}
.nav .has-menu:hover .menu.cards,.nav .has-menu.open .menu.cards{opacity:1;visibility:visible;transform:translateX(-50%) translateY(27px);}
.nav .has-menu.open>a svg{transform:rotate(180deg);}
.nav .menu.cards .ctile{background:#fff;border:1px solid var(--fog);border-radius:10px;padding:24px 22px 20px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;position:relative;overflow:hidden;color:var(--navy);text-decoration:none;transition:transform .18s var(--ease),border-color .18s,box-shadow .18s;}
.nav .menu.cards .ctile:hover{background:#fff;transform:translateY(-3px);border-color:var(--acc);box-shadow:0 12px 28px rgba(12,14,18,.1);}
.nav .menu.cards .ctile::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.nav .menu.cards .ctile:hover::before{transform:scaleX(1);}
.nav .menu.cards .ctile .ctile-ic{width:40px;height:40px;border-radius:10px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;margin-bottom:11px;}
.nav .menu.cards .ctile .ctile-ic svg{width:21px;height:21px;}
.nav .menu.cards .ctile h3{font-family:var(--font-display);font-size:18px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:4px;color:var(--navy);}
.nav .menu.cards .ctile .ctile-sub{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--steel-400);margin-bottom:13px;}
.nav .menu.cards .ctile .ctile-cta{margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:11px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.nav .menu.cards .ctile .ctile-cta svg{width:13px;height:13px;}

/* ===== FULL-IMAGE HERO (ported from design package) ===== */
@keyframes gcsKenBurns{
  0%   {opacity:0;transform:scale(1.05);}
  3%   {opacity:1;}
  30%  {opacity:1;}
  36%  {opacity:0;transform:scale(1.16);}
  100% {opacity:0;transform:scale(1.16);}
}
/* ============ HERO · FULL-IMAGE + HIGHLIGHT CARDS ============ */
.hero-fb{position:relative;overflow:hidden;background:var(--navy);}
.hero-fb-bg{position:absolute;inset:0;overflow:hidden;background:var(--navy);}
.hfb-pic{display:contents;}
.hfb-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;}
.hfb-slide{position:absolute;inset:0;background-size:cover;background-repeat:no-repeat;
  opacity:0;will-change:transform,opacity;
  animation:gcsKenBurns 27s linear infinite;}
.hfb-slide.hfb-2{background-image:url('/assets/photo-911-service.webp');background-position:center 42%;transform-origin:35% 60%;animation-delay:7s;}
.hfb-slide.hfb-3{background-image:url('/assets/photo-r8-engine.webp');background-position:center 45%;transform-origin:50% 35%;animation-delay:16s;}
.hero-fb-scrim{position:absolute;inset:0;
  background:
    linear-gradient(90deg, rgba(15,17,20,.94) 0%, rgba(15,17,20,.78) 34%, rgba(15,17,20,.30) 64%, rgba(15,17,20,.12) 100%),
    linear-gradient(0deg, rgba(15,17,20,.72) 0%, rgba(15,17,20,0) 48%);}
.hero-fb .container{position:relative;z-index:2;}
.hero-fb-grid{display:grid;grid-template-columns:1fr minmax(380px,452px);gap:clamp(40px,5vw,72px);align-items:center;
  min-height:min(82vh,780px);padding:clamp(72px,9vw,120px) 28px clamp(56px,7vw,96px);}
.eyebrow-dark{color:var(--acc-mid);}
.eyebrow-dark::before{background:var(--acc-mid);}
.hero-fb-copy{max-width:620px;}
.hero-fb-h1{color:#fff;font-size:clamp(42px,5.4vw,76px);margin:22px 0 22px;text-shadow:0 2px 30px rgba(0,0,0,.35);}
.hero-fb-h1 em{color:var(--acc-mid);font-style:normal;}
.hero-fb-lead{color:rgba(255,255,255,.82);max-width:46ch;margin-bottom:34px;}
/* featured pills under CTA */
.hero-fb-pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px;list-style:none;padding:0;}
.hfp{display:inline-flex;align-items:center;gap:9px;
  background:rgba(20,23,29,.55);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.16);border-radius:999px;
  padding:9px 16px 9px 13px;color:rgba(255,255,255,.92);
  font-size:13.5px;font-weight:600;letter-spacing:-.005em;white-space:nowrap;}
.hfp svg{width:16px;height:16px;color:var(--acc-mid);flex:none;}
.btn-outline{background:rgba(255,255,255,.06);color:#fff;border-color:rgba(255,255,255,.28);backdrop-filter:blur(6px);}
.btn-outline:hover{border-color:#fff;background:rgba(255,255,255,.12);transform:translateY(-2px);}
/* ===== REVIEW CARD COLUMN ===== */
.hero-fb-mosaic{display:block;justify-self:center;width:100%;max-width:420px;}
/* google review card (full width) — frosted glass over the hero photo */
.hfm-review{background:rgba(255,255,255,.82);backdrop-filter:blur(20px) saturate(1.3);-webkit-backdrop-filter:blur(20px) saturate(1.3);
  border:1px solid rgba(255,255,255,.55);border-radius:14px;padding:20px 22px 18px;color:var(--navy);
  box-shadow:0 26px 64px rgba(0,0,0,.46),inset 0 1px 0 rgba(255,255,255,.6);}
.hfm-rev-head{display:flex;align-items:center;gap:8px;margin-bottom:15px;}
.hfm-rev-g{display:inline-flex;align-items:center;gap:7px;}
.goog{font-family:var(--font-body);font-weight:700;font-size:21px;letter-spacing:-.02em;}
.goog .c-b{color:#4285F4;}
.goog .c-r{color:#EA4335;}
.goog .c-y{color:#FBBC05;}
.goog .c-g{color:#34A853;}
.hfm-rev-head-sub{font-size:15px;font-weight:600;color:var(--steel-500);margin-left:1px;}
.hfm-verified{margin-left:auto;display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;
  color:#1a73e8;background:#e8f0fe;padding:4px 9px 4px 7px;border-radius:999px;}
.hfm-verified svg{width:13px;height:13px;}
.hfm-rev-score{display:flex;align-items:center;gap:15px;padding-bottom:24px;
  border-bottom:1px solid rgba(255,255,255,.9);}
.hfm-rev-score>b{font-family:var(--font-display);font-size:52px;font-weight:900;line-height:.82;color:var(--navy);letter-spacing:-.02em;}
.hfm-rev-score-r{display:flex;flex-direction:column;gap:5px;}
.hfm-big-stars{color:var(--star);}
.hfm-big-stars svg{width:19px;height:19px;fill:var(--star);stroke:none;}
.hfm-rev-count{font-family:var(--mono);font-size:12px;color:var(--steel-500);}
.hfm-rev-quote{display:flex;gap:12px;padding:15px 0 4px;}
/* rotating review carousel */
.hfm-rev-carousel{display:block;}
.hfm-rev-vp{overflow:hidden;}
.hfm-rev-track{display:flex;transition:transform .34s var(--ease);}
.hfm-rev-track .hfm-rev-quote{flex:0 0 100%;min-width:0;align-items:flex-start;min-height:118px;padding-top:24px;}
/* bottom control row: arrows flank the dots */
.hfm-rev-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:6px;}
.hfm-arrow{flex:none;width:32px;height:32px;border-radius:8px;border:1px solid var(--fog);background:rgba(255,255,255,.6);color:var(--steel-500);
  display:grid;place-items:center;cursor:pointer;transition:border-color .15s var(--ease),color .15s var(--ease),background .15s var(--ease);}
.hfm-arrow:hover{border-color:var(--acc);color:var(--acc);background:#fff;}
.hfm-arrow:active{transform:scale(.95);}
.hfm-arrow svg{width:17px;height:17px;}
.hfm-dots{display:flex;justify-content:center;gap:6px;}
.hfm-dot{width:6px;height:6px;border-radius:999px;background:var(--fog);border:none;padding:0;cursor:pointer;transition:width .2s var(--ease),background .2s var(--ease);}
.hfm-dot.on{background:var(--acc);width:18px;}
.hfm-av{width:38px;height:38px;flex:none;border-radius:50%;background:#1a73e8;color:#fff;display:grid;place-items:center;font-weight:700;font-size:15px;}
.hfm-rev-body{min-width:0;}
.hfm-rev-meta{display:flex;align-items:center;gap:8px;}
.hfm-rev-meta b{font-size:14px;font-weight:700;color:var(--navy);}
.hfm-mini-stars{color:var(--star);gap:1px;}
.hfm-mini-stars svg{width:12px;height:12px;fill:var(--star);stroke:none;}
.hfm-rev-time{font-size:11px;color:var(--steel-400);font-family:var(--mono);margin:2px 0 6px;}
.hfm-rev-body p{font-size:13.5px;line-height:1.5;color:var(--steel-700);}
.hfm-rev-foot{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:14px;padding-top:13px;
  border-top:1px solid var(--fog);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
  color:var(--acc);transition:color .15s;}
.hfm-rev-foot svg{width:14px;height:14px;}
.hfm-rev-foot:hover{color:var(--acc-mid);}
/* mosaic tiles */
.hfm-tile{background:rgba(20,23,29,.66);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.12);
  border-radius:12px;padding:18px;color:#fff;min-height:120px;display:flex;flex-direction:column;
  transition:transform .16s var(--ease),border-color .16s,background .16s,box-shadow .16s;}
.hfm-tile:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.28);background:rgba(20,23,29,.82);box-shadow:0 16px 40px rgba(0,0,0,.4);}
.hfm-stat{justify-content:center;gap:6px;}
.hfm-num{font-family:var(--font-display);font-size:46px;font-weight:900;line-height:.85;color:var(--acc-mid);letter-spacing:-.02em;}
.hfm-stat span{font-size:13px;color:rgba(255,255,255,.66);font-weight:500;}
.hfm-icon{justify-content:space-between;gap:14px;}
.hfm-icon b{font-size:16px;font-weight:800;color:#fff;letter-spacing:-.01em;line-height:1.15;}
@media(max-width:980px){.hero-fb .hero-cta{display:none;}}
@media (prefers-reduced-motion:reduce){.hfb-slide{animation:none;transform:none;}.hfb-slide.hfb-2,.hfb-slide.hfb-3{display:none;}}
@media(max-width:860px){.hero-fb-grid{grid-template-columns:1fr;gap:36px;align-items:start;min-height:0;}.hfb-img{object-position:center 32%;}.hero-fb-mosaic{max-width:560px;}.hfb-slide.hfb-2,.hfb-slide.hfb-3{display:none;}.hero-fb-bg{background:radial-gradient(135% 85% at 72% 8%,#222a38 0%,#15181d 58%);}}
@media(max-width:560px){.hero-fb-scrim{background:linear-gradient(0deg, rgba(15,17,20,.82) 0%, rgba(15,17,20,.55) 60%, rgba(15,17,20,.4) 100%);}.hfm-num{font-size:40px;}}
.reveal{opacity:0;transform:translateY(22px);transition:opacity .6s var(--ease-emph),transform .6s var(--ease-emph);}
.reveal.in{opacity:1;transform:none;}`;
