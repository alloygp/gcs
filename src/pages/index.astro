---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `German &amp; European Auto Repair in San Antonio | My German Car SA`;
const DESC = `Independent Audi, BMW, Mercedes &amp; Porsche repair in San Antonio — dealer-level service without dealer prices. Carfax Top-Rated. Book online today.`;
const CANON = `https://mygermancarsa.com/`;
const SCREEN = `GCS Homepage`;
const BLOG = false;
const DEFAULT_MAKE = undefined;
const STYLE = `@import url('https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700;800;900&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap');
/* ============ DESIGN 3 · CLEAN / TRUST-FIRST ============ */
:root{
  --acc:#AF0D19;          /* GCS crimson */
  --acc-d:#850A13;        /* red pressed */
  --acc-soft:#fbe7e9;     /* faint red tint */
  --acc-mid:#D81222;      /* red bright (on dark) */
  --navy:#15181d;         /* near-black charcoal */
  --font-display:'Saira Condensed','Arial Narrow',sans-serif;
  --font-body:'Archivo','Gotham','Helvetica Neue',Arial,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;
}
body{background:var(--white);color:var(--steel-900);font-size:17px;line-height:1.6;font-family:var(--font-body);}
.wrap{overflow-x:clip;}
section{position:relative;}
.container{max-width:1220px;}

h1,h2,h3{font-weight:900;letter-spacing:-.025em;line-height:1.02;color:var(--navy);}
.brand img{height:42px;width:auto;display:block;}
.eyebrow{font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);
  display:inline-flex;align-items:center;gap:11px;}
.eyebrow::before{content:"";width:26px;height:2px;background:var(--acc);}
.display{font-family:var(--font-display);font-size:clamp(38px,4.8vw,66px);font-weight:900;letter-spacing:-.015em;line-height:1.0;text-transform:uppercase;text-wrap:balance;}
.h2{font-family:var(--font-display);font-size:clamp(34px,4.4vw,58px);font-weight:800;letter-spacing:-.01em;}
.lead{font-size:clamp(18px,1.4vw,21px);color:var(--steel-500);font-weight:400;line-height:1.62;}

.btn{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:13px;letter-spacing:.08em;text-transform:uppercase;
  padding:16px 26px;border-radius:6px;transition:transform .15s var(--ease),background .15s,box-shadow .15s;border:2px solid transparent;}
.btn svg{width:18px;height:18px;}
.btn-primary{background:var(--acc);color:#fff;box-shadow:0 10px 26px rgba(175,13,25,.24);}
.btn-primary:hover{background:var(--acc-d);transform:translateY(-2px);}
.btn-ghost{background:#fff;color:var(--navy);border-color:var(--fog);}
.btn-ghost:hover{border-color:var(--acc);color:var(--acc);}
.btn-light{background:#fff;color:var(--acc);}
.btn-light:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(0,0,0,.16);}

/* topbar */
.topbar{background:var(--navy);color:rgba(255,255,255,.8);font-size:13px;}
.topbar .container{display:flex;justify-content:space-between;align-items:center;height:40px;gap:18px;}
.topbar .tl{display:flex;gap:24px;}
.topbar .tl span{display:inline-flex;align-items:center;gap:7px;}
.topbar .tl svg{width:14px;height:14px;color:var(--acc-mid);}
.topbar .tr{display:inline-flex;align-items:center;gap:8px;font-weight:600;}
.topbar .tr .gs{color:var(--star);display:inline-flex;gap:1px;}
.topbar .tr .gs svg{width:13px;height:13px;fill:var(--star);stroke:none;}
@media(max-width:820px){.topbar .tl span:not(:first-child){display:none;}}

/* header */
.hdr{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--fog);}
.hdr .container{display:flex;align-items:center;gap:34px;height:78px;}
.brand{display:flex;align-items:center;gap:12px;}
.brand .mk{width:44px;height:44px;border-radius:12px;background:var(--acc);color:#fff;display:grid;place-items:center;font-weight:800;font-size:19px;letter-spacing:-.03em;box-shadow:0 6px 16px rgba(175,13,25,.25);}
.brand b{font-weight:800;font-size:17px;color:var(--navy);letter-spacing:-.01em;line-height:1;}
.brand small{display:block;font-size:11px;letter-spacing:.1em;color:var(--steel-400);text-transform:uppercase;margin-top:3px;}
.nav{display:flex;gap:30px;margin-left:6px;}
.nav a{font-size:15px;font-weight:500;color:var(--steel-700);transition:color .15s;}
.nav a:hover{color:var(--acc);}
.nav .has-menu{position:relative;display:flex;align-items:center;}
.nav .has-menu>a{display:inline-flex;align-items:center;gap:5px;cursor:pointer;}
.nav .has-menu>a svg{width:14px;height:14px;transition:transform .18s var(--ease);}
.nav .has-menu:hover>a svg{transform:rotate(180deg);}
.nav .menu{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(8px);min-width:242px;background:#fff;border:1px solid var(--fog);border-radius:12px;box-shadow:0 18px 44px rgba(12,14,18,.16);padding:8px;opacity:0;visibility:hidden;transition:opacity .18s var(--ease),transform .18s var(--ease);z-index:60;}
.nav .menu::before{content:"";position:absolute;top:-16px;left:0;right:0;height:16px;}
.nav .has-menu:hover .menu{opacity:1;visibility:visible;transform:translateX(-50%) translateY(12px);}
.nav .menu a{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;border-radius:8px;font-size:14px;font-weight:600;color:var(--navy);}
.nav .menu a:hover{background:var(--acc-soft);color:var(--acc);}
.nav .menu a span{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--steel-400);}
.nav .menu a .mq{display:flex;align-items:center;gap:10px;font-family:inherit;font-size:14px;font-weight:600;letter-spacing:normal;text-transform:none;color:var(--navy);}
.nav .has-menu .menu{min-width:268px;}
.nav .menu .mqi{width:30px;height:24px;display:grid;place-items:center;flex:none;}
.nav .menu .mqi img{max-width:26px;max-height:22px;object-fit:contain;display:block;}
.nav .menu.wide{min-width:286px;}
/* Makes mega-menu — full-width dark panel flush under the header border */
.nav .has-mega{position:static;display:flex;align-items:center;}
.nav .has-mega>a{display:inline-flex;align-items:center;gap:5px;cursor:pointer;}
.nav .has-mega>a svg{width:14px;height:14px;transition:transform .18s var(--ease);}
.nav .has-mega.open>a svg{transform:rotate(180deg);}
.nav .menu.mega{left:0;right:0;width:100%;min-width:0;padding:0;background:#fff;
  border:none;border-radius:0;border-top:1px solid var(--fog);
  box-shadow:0 28px 48px rgba(12,14,18,.14);transform:translateY(8px);}
.nav .has-mega.open .menu.mega{opacity:1;visibility:visible;transform:translateY(0);}
.nav .menu.mega::before{display:none;}
.mega-inner{max-width:1220px;margin:0 auto;padding:26px 28px 30px;}
.mega-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.mtile{background:#fff;border:1px solid var(--fog);border-radius:10px;
  padding:24px 22px 20px;display:flex;flex-direction:column;align-items:center;text-align:center;
  position:relative;overflow:hidden;color:var(--navy);text-decoration:none;transition:transform .18s var(--ease),border-color .18s,box-shadow .18s;}
.mtile::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.mtile:hover{transform:translateY(-3px);border-color:var(--acc);box-shadow:0 12px 28px rgba(12,14,18,.1);}
.mtile:hover::before{transform:scaleX(1);}
.mtile .mtile-logo{height:48px;display:grid;place-items:center;margin-bottom:14px;}
.mtile .mtile-logo img{max-height:40px;max-width:62px;object-fit:contain;}
.mtile h3{font-family:'Saira Condensed','Arial Narrow',sans-serif;font-size:23px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:6px;color:var(--navy);}
.mtile .mtile-sub{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:var(--steel-400);margin-bottom:16px;}
.mtile .mtile-cta{margin-top:auto;display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:700;
  letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:14px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.mtile .mtile-cta svg{width:14px;height:14px;}
.hdr-r{margin-left:auto;display:flex;align-items:center;gap:18px;}
.hdr-phone{font-weight:700;color:var(--navy);display:inline-flex;align-items:center;gap:8px;font-size:15px;}
.hdr-phone svg{width:16px;height:16px;color:var(--acc);}
.burger{display:none;background:#fff;border:1px solid var(--fog);border-radius:10px;width:46px;height:46px;color:var(--navy);place-items:center;}
@media(max-width:980px){.nav,.hdr-phone{display:none;}.burger{display:grid;}}

/* hero */
.hero{background:linear-gradient(180deg,#f4f6f9 0%,#fff 82%);padding:clamp(48px,6vw,88px) 0 clamp(44px,5vw,72px);overflow:hidden;}
.hero .container{display:grid;grid-template-columns:1.04fr .96fr;gap:56px;align-items:center;}
.hero-copy .pill{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--fog);border-radius:99px;
  padding:7px 16px 7px 8px;margin-bottom:24px;box-shadow:var(--shadow-sm,0 2px 6px rgba(0,0,0,.05));}
.hero-copy .pill .gs{display:inline-flex;gap:1px;color:var(--star);}
.hero-copy .pill .gs svg{width:15px;height:15px;fill:var(--star);stroke:none;}
.hero-copy .pill b{font-size:13px;font-weight:700;color:var(--navy);}
.hero-copy .pill span{font-size:13px;color:var(--steel-500);}
.hero-copy .display{margin:0 0 22px;}
.hero-copy .display em{color:var(--acc);font-style:normal;}
.hero-copy .display .slash{display:inline-block;width:64px;height:8px;background:var(--acc);vertical-align:middle;margin:0 0 14px;}
.hero-copy .lead{max-width:40ch;margin-bottom:32px;}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;}
.hero-mini{display:flex;gap:26px;margin-top:34px;flex-wrap:wrap;}
.hero-mini .hm{display:flex;align-items:center;gap:11px;}
.hero-mini .hm svg{width:20px;height:20px;color:var(--acc);flex:none;}
.hero-mini .hm span{font-size:14px;font-weight:600;color:var(--steel-700);}
.hero-mini .hm .hm-uber{width:20px;height:20px;border-radius:4px;flex:none;display:block;}
/* hero visual */
.hero-vis{position:relative;}
.hero-vis .frame{border-radius:16px;overflow:hidden;box-shadow:0 30px 70px rgba(12,14,18,.22);}
.hero-vis image-slot{width:100%;height:460px;display:block;}
.hero-vis .float{position:absolute;background:#fff;border-radius:16px;box-shadow:0 18px 44px rgba(12,14,18,.16);padding:18px 20px;}
.hero-vis .f-rev{left:-22px;bottom:42px;display:flex;align-items:center;gap:14px;}
.hero-vis .f-rev .big{font-size:34px;font-weight:800;color:var(--navy);letter-spacing:-.02em;line-height:1;}
.hero-vis .f-rev .gs{display:flex;gap:2px;color:var(--star);}
.hero-vis .f-rev .gs svg{width:14px;height:14px;fill:var(--star);stroke:none;}
.hero-vis .f-rev small{font-size:12px;color:var(--steel-500);display:block;margin-top:3px;}
.hero-vis .f-rev .grow{display:flex;align-items:center;gap:6px;margin-bottom:4px;}
.hero-vis .f-rev .grow b{font-size:12px;font-weight:700;color:var(--navy);letter-spacing:.01em;}
.hero-vis .f-warr{right:-24px;top:26px;left:auto;bottom:auto;padding:0;overflow:hidden;width:256px;display:block;}
.hero-vis .f-warr .map{display:block;width:100%;height:186px;border:0;}
@media(max-width:920px){.hero .container{grid-template-columns:1fr;}.hero-vis{margin-top:10px;}.hero-vis image-slot{height:340px;}.hero-vis .f-rev{left:8px;}.hero-vis .f-warr{right:8px;}}

/* trust band */
.tband{border-bottom:1px solid var(--fog);background:#fff;}
.tband .container{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 28px;flex-wrap:wrap;}
.tband .tg{display:flex;align-items:center;gap:14px;}
.tband .tg .gicon{width:42px;height:42px;border-radius:50%;border:1px solid var(--fog);display:grid;place-items:center;font-weight:800;font-size:20px;color:#4285F4;}
.tband .tg .gs{display:flex;gap:2px;color:var(--star);}
.tband .tg .gs svg{width:16px;height:16px;fill:var(--star);stroke:none;}
.tband .tg b{font-size:18px;font-weight:800;color:var(--navy);}
.tband .tg small{font-size:13px;color:var(--steel-500);display:block;}
.tband .marqs{display:flex;gap:clamp(16px,2.6vw,40px);align-items:center;flex-wrap:wrap;}
.tband .marqs b{font-weight:800;font-size:clamp(14px,1.4vw,18px);color:var(--steel-400);transition:color .2s;}
.tband .marqs b:hover{color:var(--navy);}
@media(max-width:760px){.tband .marqs{display:none;}}

/* marquee (bold) */
.marquee{background:var(--acc);color:#fff;overflow:hidden;padding:13px 0;}
.marquee .track{display:flex;width:max-content;animation:gcsscroll 32s linear infinite;}
.marquee .seg{display:flex;align-items:center;}
.marquee b{font-weight:900;font-size:18px;text-transform:uppercase;letter-spacing:.03em;padding:0 28px;display:inline-flex;align-items:center;gap:28px;}
.marquee b::after{content:"";width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.65);}
@keyframes gcsscroll{to{transform:translateX(-50%);}}

/* stat band (bold dark) */
.stats{background:var(--navy);}
.stats .container{display:grid;grid-template-columns:repeat(3,1fr);}
.statc{padding:46px 22px;text-align:center;border-right:1px solid rgba(255,255,255,.1);}
.statc:last-child{border-right:none;}
.statc b{display:block;font-weight:900;font-size:clamp(38px,4.4vw,58px);line-height:1;color:var(--acc-mid);letter-spacing:-.02em;}
.statc b .r{color:var(--acc-mid);}
.statc span{display:block;margin-top:11px;font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.55);}
@media(max-width:600px){.stats .container{grid-template-columns:1fr;}.statc{border-right:none;border-bottom:1px solid rgba(255,255,255,.1);}.statc:last-child{border-bottom:none;}}

/* section */
.sec{padding:clamp(64px,8vw,116px) 0;}
.sec-head{text-align:center;max-width:760px;margin:0 auto 58px;}
.sec-head .h2{margin:16px 0 18px;}
.sec-head .lead{margin:0 auto;}
.sec-head.left{text-align:left;margin-left:0;max-width:720px;}
.sec-head.left .eyebrow{justify-content:flex-start;}
.sec-head.left .lead{margin:0;}
.sec.alt{background:var(--paper);}

/* reviews (trust-first, high up) */
.rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.rcard{background:#fff;border:1px solid var(--fog);border-radius:12px;padding:30px;display:flex;flex-direction:column;gap:16px;
  transition:transform .2s var(--ease),box-shadow .2s;}
.rcard:hover{transform:translateY(-4px);box-shadow:0 20px 44px rgba(12,14,18,.1);}
.rcard.feat{background:var(--navy);color:#fff;border-color:var(--navy);position:relative;overflow:hidden;}
.rcard.feat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--acc);}
.rcard .rs{display:flex;gap:3px;color:var(--star);}
.rcard .rs svg{width:18px;height:18px;fill:var(--star);stroke:none;}
.rcard p{font-size:16px;color:var(--steel-700);font-weight:400;line-height:1.62;flex:1;}
.rcard.feat p{color:rgba(255,255,255,.94);font-size:18px;font-weight:500;}
.rcard .who{display:flex;align-items:center;gap:12px;padding-top:16px;border-top:1px solid var(--fog);}
.rcard.feat .who{border-color:rgba(255,255,255,.2);}
.rcard .av{width:42px;height:42px;border-radius:50%;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;font-weight:800;font-size:15px;}
.rcard.feat .av{background:rgba(255,255,255,.16);color:#fff;}
.rcard .who b{font-size:15px;font-weight:700;color:var(--navy);display:block;}
.rcard.feat .who b{color:#fff;}
.rcard .who span{font-size:13px;color:var(--steel-400);}
.rcard.feat .who span{color:rgba(255,255,255,.7);}
.rev-cta{text-align:center;margin-top:44px;}
@media(max-width:920px){.rev-grid{grid-template-columns:1fr;}}

/* dealer compare */
.deal{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
.dcard{border-radius:12px;padding:40px 36px;border:1px solid var(--fog);}
.dcard.win{background:linear-gradient(155deg,rgba(17,19,21,.90) 0%,rgba(17,19,21,.95) 55%,rgba(17,19,21,.98) 100%),url('/assets/photo-r8-engine.jpeg') center/cover no-repeat;color:#fff;border-color:var(--navy);box-shadow:0 24px 56px rgba(12,14,18,.24);position:relative;overflow:hidden;}
.dcard h3{font-size:24px;margin-bottom:6px;}
.dcard.win h3{color:#fff;}
.dcard .sub{font-size:14px;color:var(--steel-400);margin-bottom:26px;}
.dcard.win .sub{color:var(--acc-mid);font-weight:700;}
.dcard ul{display:flex;flex-direction:column;gap:16px;}
.dcard li{display:flex;gap:13px;align-items:flex-start;font-size:16px;line-height:1.45;}
.dcard li svg{width:22px;height:22px;flex:none;margin-top:1px;}
.dcard.win li svg{color:var(--acc-mid);}
.dcard.win li{color:rgba(255,255,255,.92);}
.dcard.lose li{color:var(--steel-500);}
.dcard.lose li svg{color:var(--steel-300);}
@media(max-width:720px){.deal{grid-template-columns:1fr;}}

/* services */
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;counter-reset:svc;}
.svc{position:relative;overflow:hidden;background:#fff;border:1px solid var(--fog);border-radius:12px;padding:32px;transition:transform .2s var(--ease),box-shadow .2s,border-color .2s;counter-increment:svc;}
.svc::after{content:counter(svc,decimal-leading-zero);position:absolute;top:20px;right:24px;font-family:var(--font-display);font-size:30px;font-weight:800;line-height:1;color:var(--fog);transition:color .2s;pointer-events:none;}
.svc:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(12,14,18,.1);border-color:var(--acc);}
.svc:hover::after{color:var(--acc);}
.svc .ico{width:54px;height:54px;border-radius:14px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;margin-bottom:22px;transition:background .2s,color .2s;}
.svc:hover .ico{background:var(--acc);color:#fff;}
.svc .ico svg{width:27px;height:27px;}
.svc h3{font-size:21px;margin-bottom:10px;}
.svc p{font-size:15px;color:var(--steel-500);font-weight:400;line-height:1.6;}
@media(max-width:920px){.svc-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:600px){.svc-grid{grid-template-columns:1fr;}}

/* by-make selector */
.makes-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.makecard{background:#fff;border:1px solid var(--fog);border-radius:12px;padding:30px 26px 24px;display:flex;flex-direction:column;text-align:center;align-items:center;position:relative;overflow:hidden;color:var(--navy);transition:transform .2s var(--ease),border-color .2s,box-shadow .2s;}
.makecard::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--acc);transform:scaleX(0);transition:transform .22s var(--ease);}
.makecard:hover{transform:translateY(-4px);border-color:var(--acc);box-shadow:0 18px 40px rgba(12,14,18,.1);}
.makecard:hover::before{transform:scaleX(1);}
.makecard .ml{height:50px;display:grid;place-items:center;margin-bottom:16px;}
.makecard .ml img{max-height:42px;max-width:64px;object-fit:contain;}
.makecard h3{font-family:var(--font-display);font-size:24px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin-bottom:5px;}
.makecard .mline{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--steel-400);margin-bottom:14px;}
.makecard p{font-size:14px;color:var(--steel-500);font-weight:400;line-height:1.55;margin-bottom:18px;}
.makecard .mcta{margin-top:auto;display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--acc);padding-top:16px;border-top:1px solid var(--fog);width:100%;justify-content:center;}
.makecard .mcta svg{width:15px;height:15px;}
@media(max-width:900px){.makes-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:480px){.makes-grid{grid-template-columns:1fr;}}
/* dark section variant (used as a mid-page anchor band) */
.sec.dark{background:var(--navy);color:#fff;}
.sec.dark .sec-head .h2,.sec.dark h2{color:#fff;}
.sec.dark .eyebrow{color:var(--acc-mid);}
.sec.dark .eyebrow::before{background:var(--acc-mid);}
.sec.dark .lead{color:rgba(255,255,255,.72);}
.sec.dark .makecard{background:rgba(255,255,255,.045);border-color:rgba(255,255,255,.12);color:#fff;}
