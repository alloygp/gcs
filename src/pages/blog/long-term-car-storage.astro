---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;
const TITLE = `Long-Term Car Storage: A German Car Owner's Guide | My German Car SA`;
const DESC = `How to store your BMW, Porsche or Audi long-term without damage — battery, fluids, tires, fuel and pests. A San Antonio specialist's checklist.`;
