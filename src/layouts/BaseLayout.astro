---
// German Car Specialists — base layout. Wraps every page with the shared
// head, sticky header + nav, make-picker bar, mobile drawer, footer, and runtime.
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  screenLabel?: string;   // [data-screen-label] for review/comment context
  blog?: boolean;         // also load blog.css
  defaultMake?: string;   // pre-highlight a make in the picker bar (brand pages)
}
const { title, description, canonical, screenLabel = '', blog = false, defaultMake } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="/assets/icon.png" />
  <link rel="stylesheet" href="/assets/base.css" />
  <link rel="stylesheet" href="/assets/make-page.css" />
  {blog && <link rel="stylesheet" href="/assets/blog.css" />}
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  <slot name="head" />
</head>
<body>
<div class="wrap" data-screen-label={screenLabel}>

  <!-- TOPBAR -->
  <div class="topbar"><div class="container">
    <div class="tl">
      <span><i data-lucide="map-pin"></i>15555 Tradesman Dr, Ste 500 · San Antonio</span>
      <span><i data-lucide="clock"></i>Mon–Fri 8:00a–5:30p</span>
    </div>
    <div class="tr"><span class="gs" id="tb-s"></span> <b>4.9</b> · 325 Google reviews</div>
  </div></div>

  <!-- HEADER -->
  <header class="hdr" id="hdr"><div class="container">
    <a class="brand" href="/"><img src="/assets/logo-color.png" alt="German Car Specialists" /></a>
    <nav class="nav">
      <a href="/about">Our Shop</a>
      <div class="has-mega" id="makesMenu">
        <a href="#">Makes <i data-lucide="chevron-down"></i></a>
        <div class="menu mega">
          <div class="mega-inner">
            <div class="mega-grid">
              <a class="mtile" href="/audi-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/audi.svg" alt="Audi" /></span><h3>Audi</h3><span class="mtile-sub">A · S · RS · R8</span><span class="mtile-cta">Audi Service <i data-lucide="arrow-right"></i></span></a>
              <a class="mtile" href="/bmw-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/bmw.svg" alt="BMW" /></span><h3>BMW</h3><span class="mtile-sub">3 · 5 · X · M</span><span class="mtile-cta">BMW Service <i data-lucide="arrow-right"></i></span></a>
              <a class="mtile" href="/mercedes-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/mercedes.svg" alt="Mercedes-Benz" /></span><h3>Mercedes</h3><span class="mtile-sub">C · E · S · AMG</span><span class="mtile-cta">Mercedes Service <i data-lucide="arrow-right"></i></span></a>
              <a class="mtile" href="/porsche-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/porsche.svg" alt="Porsche" /></span><h3>Porsche</h3><span class="mtile-sub">911 · Cayenne · Macan</span><span class="mtile-cta">Porsche Service <i data-lucide="arrow-right"></i></span></a>
            </div>
          </div>
        </div>
      </div>
      <div class="has-menu">
        <a href="/independent-vs-dealer-german-auto-service">Why Us <i data-lucide="chevron-down"></i></a>
        <div class="menu cards">
          <div class="why-cards">
            <a class="ctile" href="/independent-vs-dealer-german-auto-service"><span class="ctile-ic"><i data-lucide="scale"></i></span><h3>Dealer vs. Independent</h3><span class="ctile-sub">The Comparison</span><span class="ctile-cta">See the difference <i data-lucide="arrow-right"></i></span></a>
            <a class="ctile" href="/reviews"><span class="ctile-ic"><i data-lucide="star"></i></span><h3>Reviews</h3><span class="ctile-sub">4.9 ★ · 325</span><span class="ctile-cta">Read reviews <i data-lucide="arrow-right"></i></span></a>
          </div>
          <a class="why-cred" href="/reviews" aria-label="Carfax Top-Rated Service Center 2025">
            <img src="/assets/CarFax/1920x1080-hero.png" alt="We're a Carfax 2025 Top-Rated Service Center — German Car Specialists" />
          </a>
        </div>
      </div>
      <a href="/shop-notes">Shop Notes</a>
    </nav>
    <div class="hdr-r">
      <a class="hdr-phone" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
      <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
    </div>
    <button class="burger" id="burger" aria-label="Menu"><i data-lucide="menu"></i></button>
  </div></header>

  <!-- CAR PICKER BAR -->
  <div class="carbar" id="carbar" data-default-make={defaultMake}>
    <div class="container">
      <span class="cb-label"><i data-lucide="car-front"></i><span class="cb-text">Choose your make</span></span>
      <div class="cb-chips">
        <button class="cb-chip" data-make="Audi" type="button"><img src="/assets/marques/audi.svg" alt="" />Audi</button>
        <button class="cb-chip" data-make="BMW" type="button"><img src="/assets/marques/bmw.svg" alt="" />BMW</button>
        <button class="cb-chip" data-make="Mercedes" type="button"><img src="/assets/marques/mercedes.svg" alt="" />Mercedes</button>
        <button class="cb-chip" data-make="Porsche" type="button"><img src="/assets/marques/porsche.svg" alt="" />Porsche</button>
      </div>
      <button class="cb-reset" id="cbReset" type="button" aria-label="Reset selection" title="Reset" hidden><i data-lucide="x"></i></button>
    </div>
  </div>

  <!-- PAGE CONTENT -->
  <slot />

  <!-- FOOTER -->
  <footer class="ftr"><div class="container">
    <div class="ftr-grid">
      <div>
        <a class="brand" href="/"><img src="/assets/logo-white.png" alt="German Car Specialists" /></a>
        <p>The independent dealer alternative for German &amp; European cars in San Antonio. Audi, BMW, Mercedes &amp; Porsche — factory-trained, honestly run, fully warrantied. Carfax Top-Rated since 2010.</p>
      </div>
      <div><h4>By Make</h4><ul><li><a href="/audi-repair-san-antonio">Audi Repair</a></li><li><a href="/bmw-repair-san-antonio">BMW Repair</a></li><li><a href="/mercedes-repair-san-antonio">Mercedes Repair</a></li><li><a href="/porsche-repair-san-antonio">Porsche Repair</a></li></ul></div>
      <div><h4>Company</h4><ul><li><a href="/about">About Us</a></li><li><a href="/independent-vs-dealer-german-auto-service">Dealer vs. Independent</a></li><li><a href="/reviews">Reviews</a></li><li><a href="/shop-notes">Shop Notes</a></li><li><a href="/appointments">Book / Contact</a></li></ul></div>
      <div>
        <h4>Visit the shop</h4>
        <div class="ct"><i data-lucide="map-pin"></i>15555 Tradesman Dr, Ste 500, San Antonio, TX 78249</div>
        <div class="ct"><i data-lucide="phone"></i>(210) 399-1172</div>
        <div class="ct"><i data-lucide="clock"></i>Mon–Fri 8:00a–5:30p</div>
        <a class="btn btn-light" href="/appointments" style="margin-top:8px"><i data-lucide="calendar-check"></i>Book / Contact</a>
      </div>
    </div>
    <div class="ftr-bottom"><span>© 2026 German Car Specialists — San Antonio, TX</span><span>Audi · BMW · Mercedes-Benz · Porsche</span></div>
  </div></footer>

  <!-- DRAWER -->
  <div class="drawer" id="drawer">
    <div class="dh"><a class="brand" href="/"><img src="/assets/logo-color.png" alt="German Car Specialists" /></a>
    <button class="dx" id="dx"><i data-lucide="x"></i></button></div>
    <a href="/">Home</a><a href="/audi-repair-san-antonio">Audi Repair</a><a href="/bmw-repair-san-antonio">BMW Repair</a><a href="/mercedes-repair-san-antonio">Mercedes Repair</a><a href="/porsche-repair-san-antonio">Porsche Repair</a><a href="/shop-notes">Shop Notes</a><a href="/about">Our Shop</a><a href="/independent-vs-dealer-german-auto-service">Dealer vs. Independent</a><a href="/reviews">Reviews</a>
    <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
  </div>

</div>

<!-- page-level scripts (JSON-LD, etc.) -->
<slot name="end" />

<script is:inline src="/image-slot.js"></script>
<script is:inline src="/site.js"></script>
</body>
</html>
