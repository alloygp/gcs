---
import baseCssRaw from '../../public/assets/base.css?raw';
import makeCssRaw from '../../public/assets/make-page.css?raw';
import mobileCssRaw from '../../public/assets/mobile.css?raw';
import blogCssRaw from '../../public/assets/blog.css?raw';
// German Car Specialists — base layout. Wraps every page with the shared
// head, sticky header + nav, make-picker bar, mobile drawer, footer, and runtime.
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  screenLabel?: string;   // [data-screen-label] for review/comment context
  blog?: boolean;         // also load blog.css
  defaultMake?: string;   // pre-highlight a make in the picker bar (brand pages)
}
const { title, description, canonical, screenLabel = '', blog = false, defaultMake } = Astro.props;
// Cache-buster for the static /assets CSS files. These live in public/ (not
// hashed by Astro), and Vercel caches /assets immutably. Bump this when a CSS
// change must reach already-cached browsers. Going forward the must-revalidate
// header on *.css (vercel.json) keeps them fresh without bumping.
const CSS_V = '6';
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// A page is indexable ONLY when it's the production build AND the real domain is live.
// PUBLIC_ENV=production stays set on prod for app behavior (GA, etc.); indexability is
// gated separately by PUBLIC_SITE_LIVE so prod can run noindexed until the domain is pointed.
// → Launch day: add PUBLIC_SITE_LIVE=true to the Vercel production project and redeploy.
// Everything else (staging, preview, local, pre-launch prod) emits noindex but stays
// crawlable (no nofollow) so QA/audit tools can follow links normally.
const isProduction = import.meta.env.PUBLIC_ENV === 'production';
const indexable = isProduction && import.meta.env.PUBLIC_SITE_LIVE === 'true';
const ogImage = new URL('/assets/og.png', Astro.site).href;
// GA4: set PUBLIC_GA_MEASUREMENT_ID (G-XXXXXXXXXX) in Vercel prod env. Only loads in production.
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isHome = Astro.url.pathname === '/';
// Inlined (above, via ?raw) to remove render-blocking stylesheet requests.
// base.css's relative ../fonts/ paths -> absolute /fonts/ (CSS now in document).
const headCss = baseCssRaw.split('../fonts/').join('/fonts/') + '\n' + makeCssRaw;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Homepage hero photo: desktop only (mobile uses a CSS gradient — no LCP image). Preloaded early so it isn't load-delayed. */}
  {isHome && <link rel="preload" as="image" href="/assets/photo-audi-r8-shop.webp?v=hero2" media="(min-width:861px)" fetchpriority="high" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Saira+Condensed:wght@500;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Saira+Condensed:wght@500;600;700;800;900&display=swap" /></noscript>
  {!indexable && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="German Car Specialists" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  {isProduction && GA_ID && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script is:inline define:vars={{ GA_ID }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',GA_ID);</script>
    </Fragment>
  )}
  {/* Ahrefs Web Analytics — production only, so staging/preview/local traffic isn't counted. */}
  {isProduction && (
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="yAIXuWPEZq7aUBDItOt2+Q" async></script>
  )}
  {/* WhatConverts lead tracking (profile 148045) — production only. Kept as WhatConverts ships it. */}
  {isProduction && (
    <Fragment>
      <script is:inline>{`var $wc_load=function(a){return JSON.parse(JSON.stringify(a))},$wc_leads=$wc_leads||{doc:{url:$wc_load(document.URL),ref:$wc_load(document.referrer),search:$wc_load(location.search),hash:$wc_load(location.hash)}};`}</script>
      <script is:inline src="//s.ksrndkehqnwntyxlhgto.com/148045.js"></script>
    </Fragment>
  )}
  <style is:inline set:html={headCss}></style>
  {blog && <style is:inline set:html={blogCssRaw}></style>}
  <script is:inline defer src="/assets/lucide.min.js"></script>
  <slot name="head" />
  <!-- Inlined LAST so its @media rules override make-page + per-page inline styles. -->
  <style is:inline set:html={mobileCssRaw}></style>
</head>
<body>
<div class="wrap" data-screen-label={screenLabel}>

  <!-- TOPBAR -->
  <div class="topbar"><div class="container">
    <div class="tl">
      <span><i data-lucide="map-pin"></i>15555 Tradesman Dr, Ste 500 · San Antonio</span>
      <span><i data-lucide="clock"></i>Mon–Thu 7:30a–5:30p · Fri 7:30a–5p</span>
    </div>
    <div class="tr"><span class="gs" id="tb-s"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.6 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></span> <b>4.9</b> · Google reviews</div>
  </div></div>

  <!-- HEADER -->
  <header class="hdr" id="hdr"><div class="container">
    <a class="brand" href="/"><img src="/assets/logo-color.png" alt="German Car Specialists" width="600" height="149" /></a>
    <nav class="nav">
      <a href="/about">Our Shop</a>
      <div class="has-mega" id="makesMenu">
        <a href="#">Makes <i data-lucide="chevron-down"></i></a>
        <div class="menu mega">
          <div class="mega-inner">
            <div class="mega-grid">
              <a class="mtile" href="/audi-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/audi.svg" alt="Audi"  width="48" height="48" /></span><h3>Audi</h3><span class="mtile-sub">A · S · RS · R8</span><span class="mtile-cta">Audi Service <i data-lucide="arrow-right"></i></span></a>
              <a class="mtile" href="/bmw-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/bmw.svg" alt="BMW"  width="48" height="48" /></span><h3>BMW</h3><span class="mtile-sub">3 · 5 · X · M</span><span class="mtile-cta">BMW Service <i data-lucide="arrow-right"></i></span></a>
              <a class="mtile" href="/mercedes-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/mercedes.svg" alt="Mercedes-Benz"  width="48" height="48" /></span><h3>Mercedes</h3><span class="mtile-sub">C · E · S · AMG</span><span class="mtile-cta">Mercedes Service <i data-lucide="arrow-right"></i></span></a>
              <a class="mtile" href="/porsche-repair-san-antonio"><span class="mtile-logo"><img src="/assets/marques/porsche.svg" alt="Porsche"  width="48" height="48" /></span><h3>Porsche</h3><span class="mtile-sub">911 · Cayenne · Macan</span><span class="mtile-cta">Porsche Service <i data-lucide="arrow-right"></i></span></a>
            </div>
          </div>
        </div>
      </div>
      <div class="has-menu">
        <a href="/independent-vs-dealer-german-auto-service">Why Us <i data-lucide="chevron-down"></i></a>
        <div class="menu cards">
          <div class="why-cards">
            <a class="ctile" href="/independent-vs-dealer-german-auto-service"><span class="ctile-ic"><i data-lucide="scale"></i></span><h3>Dealer vs. Independent</h3><span class="ctile-sub">The Comparison</span><span class="ctile-cta">See the difference <i data-lucide="arrow-right"></i></span></a>
            <a class="ctile" href="/reviews"><span class="ctile-ic"><i data-lucide="star"></i></span><h3>Reviews</h3><span class="ctile-sub">4.9 ★ Google</span><span class="ctile-cta">Read reviews <i data-lucide="arrow-right"></i></span></a>
          </div>
          <a class="why-cred" href="/reviews" aria-label="Carfax Top-Rated Service Center 2025">
            <img src="/assets/CarFax/1920x1080-hero.png" alt="We're a Carfax 2025 Top-Rated Service Center — German Car Specialists" />
          </a>
        </div>
      </div>
      <a href="/shop-notes">Shop Notes</a>
    </nav>
    <div class="hdr-r">
      <a class="hdr-phone" href="tel:+12103991172"><i data-lucide="phone"></i>(210) 399-1172</a>
      <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
    </div>
    <button class="burger" id="burger" aria-label="Menu"><i data-lucide="menu"></i></button>
  </div></header>

  <!-- CAR PICKER BAR -->
  <div class="carbar" id="carbar" data-default-make={defaultMake}>
    <div class="container">
      <span class="cb-label"><i data-lucide="car-front"></i><span class="cb-text">Choose your make</span></span>
      <div class="cb-chips">
        <button class="cb-chip" data-make="Audi" type="button"><img src="/assets/marques/audi.svg" alt="Audi"  width="48" height="48" />Audi</button>
        <button class="cb-chip" data-make="BMW" type="button"><img src="/assets/marques/bmw.svg" alt="BMW"  width="48" height="48" />BMW</button>
        <button class="cb-chip" data-make="Mercedes" type="button"><img src="/assets/marques/mercedes.svg" alt="Mercedes-Benz"  width="48" height="48" />Mercedes</button>
        <button class="cb-chip" data-make="Porsche" type="button"><img src="/assets/marques/porsche.svg" alt="Porsche"  width="48" height="48" />Porsche</button>
      </div>
      <button class="cb-reset" id="cbReset" type="button" aria-label="Reset selection" title="Reset" hidden><i data-lucide="x"></i></button>
    </div>
  </div>

  <!-- PAGE CONTENT -->
  <main id="content"><slot /></main>

  <!-- FOOTER -->
  <footer class="ftr"><div class="container">
    <div class="ftr-grid">
      <div>
        <a class="brand" href="/"><img src="/assets/logo-white.png" alt="German Car Specialists" /></a>
        <p>The independent dealer alternative for German &amp; European cars in San Antonio. Audi, BMW, Mercedes &amp; Porsche — factory-trained, honestly run, fully warrantied. Carfax Top-Rated since 2010.</p>
      </div>
      <div><h3>By Make</h3><ul><li><a href="/audi-repair-san-antonio">Audi Repair</a></li><li><a href="/bmw-repair-san-antonio">BMW Repair</a></li><li><a href="/mercedes-repair-san-antonio">Mercedes Repair</a></li><li><a href="/porsche-repair-san-antonio">Porsche Repair</a></li></ul></div>
      <div><h3>Company</h3><ul><li><a href="/about">About Us</a></li><li><a href="/independent-vs-dealer-german-auto-service">Dealer vs. Independent</a></li><li><a href="/reviews">Reviews</a></li><li><a href="/shop-notes">Shop Notes</a></li><li><a href="/appointments">Book / Contact</a></li></ul></div>
      <div>
        <h3>Visit the shop</h3>
        <div class="ct"><i data-lucide="map-pin"></i>15555 Tradesman Dr, Ste 500, San Antonio, TX 78249</div>
        <div class="ct"><i data-lucide="phone"></i>(210) 399-1172</div>
        <div class="ct"><i data-lucide="clock"></i>Mon–Thu 7:30a–5:30p · Fri 7:30a–5p</div>
        <a class="btn btn-light" href="/appointments" style="margin-top:8px"><i data-lucide="calendar-check"></i>Book / Contact</a>
      </div>
    </div>
    <div class="ftr-bottom"><span>© 2026 German Car Specialists — San Antonio, TX</span><span>Audi · BMW · Mercedes-Benz · Porsche</span></div>
  </div></footer>

  <!-- DRAWER -->
  <div class="drawer" id="drawer">
    <div class="dh"><a class="brand" href="/"><img src="/assets/logo-color.png" alt="German Car Specialists" width="600" height="149" /></a>
    <button class="dx" id="dx" aria-label="Close menu"><i data-lucide="x"></i></button></div>
    <a href="/">Home</a><a href="/audi-repair-san-antonio">Audi Repair</a><a href="/bmw-repair-san-antonio">BMW Repair</a><a href="/mercedes-repair-san-antonio">Mercedes Repair</a><a href="/porsche-repair-san-antonio">Porsche Repair</a><a href="/shop-notes">Shop Notes</a><a href="/about">Our Shop</a><a href="/independent-vs-dealer-german-auto-service">Dealer vs. Independent</a><a href="/reviews">Reviews</a>
    <a class="btn btn-primary" href="/appointments"><i data-lucide="calendar-check"></i>Book / Contact</a>
  </div>

</div>

<!-- page-level scripts (JSON-LD, etc.) -->
<slot name="end" />

<script is:inline src="/image-slot.js"></script>
<script is:inline src="/date-picker.js"></script>
<script is:inline defer src="/site.js"></script>
</body>
</html>
